#!/usr/bin/env node
// reeve — the control plane's front door.
//
// Node >=24 is a hard floor: node:sqlite still emits an ExperimentalWarning on
// 22.x and the state layer is the authority, so it must not run under a warning
// it might one day become.
import { runDoctor, render, checkAppIdentity, hubFindings, renderHub } from "../src/doctor.mjs";
import { open } from "../src/db/ops.mjs";
import { statePathFor, dashPathFor, legacyStatePathFor, legacyDashPathFor, hubPathFor } from "../src/paths.mjs";
import { hubAccess } from "../src/build/hubaccess.mjs";
import { resolveRepoIdAt } from "../src/build/repoid.mjs";
import { loadRegistry } from "../src/build/registryio.mjs";
import { snapshot, restore, latestSnapshot, exportEvents,
         snapshotAll, restoreHub, validateSnapshot } from "../src/backup.mjs";
import { validate, withDefaults } from "../src/profile/schema.mjs";
import { run, tick, measuredContainment } from "../src/daemon.mjs";
import { readState, render as renderStatus, statusline, why, cleanMergeRate } from "../src/status.mjs";
import { init } from "../src/init.mjs";
import { writeDash } from "../src/dash.mjs";
import { execFileSync } from "node:child_process";
// `readdirSync` is `newestCandidate`'s. Its absence was WORSE than basename's:
// that path catches its own errors and converts them to null, so an
// unimported helper silently reported "no newest candidate" instead of
// throwing -- hiding an invalid newest snapshot rather than announcing it.
// `openSync`/`writeSync`/`fsyncSync`/`closeSync` and `rmSync` are
// `export-events`': a durable tail is published temp-then-rename, and a rename
// over a file whose bytes are still only in the page cache publishes a name for
// content that a power loss can take away.
import { existsSync, mkdirSync, renameSync, readFileSync, writeFileSync, readdirSync,
         openSync, writeSync, fsyncSync, closeSync, rmSync } from "node:fs";
// `basename` is `snapshotFor`/`newestCandidate`'s: they read a snapshot's
// creation time from its `<epoch>.db` FILENAME rather than its mtime, because
// a copy back from off-device carries a fresh mtime and would report a
// days-old recovery point as fresh.
import { join, dirname, resolve, basename } from "node:path";
// `export-events --hub` writes the manifest digest and `restore --hub --tail`
// recomputes it over the bytes it read. Both routes live in this file.
import { createHash } from "node:crypto";
import { fileURLToPath } from "node:url";
import { homedir } from "node:os";
import { resolveHome } from "../src/home.mjs";
// The build route. `HUB_TABLES` is deliberately NOT here: Task 9 adds that
// export, and ESM rejects a missing named export at module instantiation, so
// naming it now would stop EVERY reeve command from starting.
// `build status` and `build run` both open the hub RAW before migrating: the
// lease has to be taken before `openHub` applies a forward migration, or an old
// builder migrates a store it is about to be refused from. Task 9 adds the same
// import for the export/restore routes; whichever lands first owns it.
import { DatabaseSync } from "node:sqlite";
import { openHub, HUB_SCHEMA_VERSION, HUB_BUSY_TIMEOUT_MS, completedVersion, faultKind } from "../src/build/hubdb.mjs";
import { acquireSingleton, heartbeatSingleton, releaseSingleton } from "../src/build/locks.mjs";
import { buildTick } from "../src/build/loop.mjs";
import { readStart, isSameProcess } from "../src/supervisor.mjs";
import { HEARTBEAT_SECONDS } from "../src/db/ops.mjs";


const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));

// Every other command in this file is `console.error(...); process.exit(1)`.
// One helper for the whole file, written once rather than invented per route.
const die = (msg) => { console.error(msg); process.exit(1); };

// The registry is projects.json under the reeve home. An unreadable or absent
// one yields NO projects rather than throwing: doctor must still report the
// findings it can compute, and "the registry could not be read" is itself a
// finding rather than a crash.
// The TOP-LEVEL object, not `reg.projects`. The design doc fixes the format at
// §1.5: `~/.reeve/projects.json` is `{name: {repoPath, nwo, profilePath,
// worktreeRoot, specRepo?, ledger?}}` -- there is no `projects` wrapper, so
// reading one returned [] on every real file and the CLI passed no projects at
// all, silently suppressing the absent-row H-4 failures this loader was added to
// expose. A defaulted `?? {}` is what made it silent.
//
// `nwo`, and no `repoId`: the registry format carries no numeric repository id
// (§1.5, and measured -- resolving one needs the App client, which
// `builder doctor` deliberately does not use). So H-4 matches projects to
// `repo_gate_state` rows by `nwo_snapshot`, which both sides have.
// The guardian's hub access lives in `src/build/hubaccess.mjs` so it can be
// TESTED. It was written here first, and a stub loop proved the point: with the
// logic inside a CLI script the only assertions available were structural, and
// disabling the version gate with `if (false && ...)` left the source text
// intact and every one of them green. A property whose test cannot fail is not
// tested.
const guardianHubAccess = () => hubAccess(hubPathFor(HOME));

// The numeric repository id, resolved OUTSIDE the guardian's restricted
// connection and handed in as a number.
//
// The guest cannot answer this. `repoIdFromHub` reads `task`, and `task` is not
// on the guardian's allowlist -- deliberately, because section 13 says the
// guardian's surface is the provider scheduler and `pr_hold`, and reading the
// builder's work table would be the third touch the guest connection exists to
// refuse. Handing the guest to the resolver made every production tick throw,
// leave `repoId` null, and fail closed on every dispatch.
//
// So the CLI answers it, with a privileged handle held for one statement and
// closed immediately. The running loop never sees privilege; `src/daemon.mjs`
// cannot reach the privileged opener at all. The end state -- an identity table
// the guest may read, removing this last privileged read -- is issue #46.
// GitHub's numeric id for a repository, the fallback half of the founder's
// resolver ruling.
//
// The hub is asked FIRST and answers for any project it has admitted a task
// for. A registered project it has not is an ordinary state for the shared
// resolver -- and for the GUARDIAN it is fatal, because a null id fails every
// dispatch closed and the ten-minute retry only repeats the same empty local
// query. Adding a repository to the registry would have disabled its guardian
// until the builder happened to file something.
//
// Never guessed and never cached anywhere but the hub: this asks GitHub, and a
// non-integer answer is no answer. A failure returns null rather than throwing,
// because the caller's contract is that the id may be unknown -- what must not
// happen is inventing one.
const repoIdFromGitHub = (nwo) => {
  try {
    const out = execFileSync("gh", ["api", `repos/${nwo}`, "--jq", ".id"],
                             { encoding: "utf8", timeout: 15_000 }).trim();
    const id = Number(out);
    return Number.isInteger(id) && id > 0 ? id : null;
  } catch { return null; }
};

const repoIdOnce = async (project) => {
  if (!project) return null;
  const p = hubPathFor(HOME);
  // DELEGATED, NOT RESTATED. The open options and the benign/fault split are the
  // lookup's own invariants, and while they lived in this catch the only thing
  // that could assert them was a regex over this file's source text -- so
  // disabling either left every assertion green. `resolveRepoIdAt` owns both,
  // where a hub can be built in each state and asked.
  return await resolveRepoIdAt(p, project, { fetchRepoId: repoIdFromGitHub });
};

// The registry loader lives in `src/build/registryio.mjs` now, with its rules
// and their measured reasons. It is called through `loadRegistry` here; the
// shape returned is unchanged, so every route below reads `.projects` and
// `.error` exactly as it did.
const registryProjects = (home) => loadRegistry(home);

// One home for every command. Four of them read REEVE_HOME and loadProfile did
// not, so a scratch home redirected a project's state database but not the
// profile describing it -- the two halves of one project's configuration read
// from different roots, which is unusable for a test and wrong for an operator.

// 24.10, not 24. `node:sqlite` is unflagged and unwarned from 24 -- which is
// what this floor used to say -- but `DatabaseSync.setAuthorizer` arrived in
// 24.10.0, and the guardian's hub connection is built on it. On 24.0 through
// 24.9, which the old `>=24` engine range admitted, opening that connection
// throws a TypeError before it can return anything. A floor that admits a
// runtime the code cannot run on is not a floor.
const [major, minor] = process.versions.node.split(".").map(Number);
if (major < 24 || (major === 24 && minor < 10)) {
  console.error(`reeve: node ${process.versions.node} — node:sqlite is unflagged from 24, and ` +
                `DatabaseSync.setAuthorizer (which the guardian's hub connection needs) from 24.10. ` +
                `Use 24.10 or newer.`);
  process.exit(1);
}

const argv = process.argv.slice(2);
// The COMMAND IS THE FIRST POSITIONAL, and it is decided by the walk below
// rather than before it.
//
// Two failures came from deciding it first. `argv.shift()` took the first token
// whatever it was, so `reeve --help` consumed `--help` as the command name and
// the one invocation everybody tries first printed the help and exited 1. Then
// treating a leading flag as "no command" was worse: `reeve --home /scratch
// backup --hub` left `backup` sitting in the positionals, fell through to the
// default branch, printed the help and exited ZERO -- a backup that never ran,
// reporting success to whatever automation asked for it. Silence with a
// success code is the exact failure this whole change is about.
//
// Only the walk knows which tokens are values, so only the walk can say which
// token is the command.

// ── every flag this CLI accepts, declared ONCE ──────────────────────────────
//
// There were two facts about a flag -- does it exist, and does it take a value
// -- and only the second was written down, in `VALUED`. They had already
// drifted: `VALUED`'s own comment says it exists so "a valued flag consumes the
// token after it, so that token is never mistaken for a repo name however much
// it looks like one", and SIX flags that take values were missing from it.
//
// Measured before this change: `reeve backup --to some/place` answered
// `no state at <home>/state/some/place.db` -- it had read the FLAG'S VALUE as
// the repository name, which is exactly the failure that comment describes.
// `--tail`, `--from`, `--keep`, `--days` and `--backups` were all in the same
// state.
//
// So there is one declaration now and `VALUED` is derived from it. `what` is
// here because a flag nobody can look up is a flag nobody uses correctly.
const FLAGS = {
  home:           { value: true,  what: "the reeve home to operate on (default $REEVE_HOME, else ~/.reeve)" },
  db:             { value: true,  what: "path to a state database" },
  log:            { value: true,  what: "path to the log file" },
  halt:           { value: true,  what: "path to the halt marker" },
  interval:       { value: true,  what: "seconds between ticks" },
  last:           { value: true,  what: "how many recent entries to show" },
  out:            { value: true,  what: "where to write output" },
  dash:           { value: true,  what: "path to the dashboard html" },
  profile:        { value: true,  what: "path to a profile json" },
  set:            { value: true,  what: "a key=value profile override" },
  "plugin-cache": { value: true,  what: "path to the plugin cache" },
  "plugin-repo":  { value: true,  what: "path to the plugin repository" },
  to:             { value: true,  what: "backup root to write into" },
  from:           { value: true,  what: "snapshot to restore from" },
  backups:        { value: true,  what: "backup root to read from" },
  keep:           { value: true,  what: "how many snapshots to retain" },
  days:           { value: true,  what: "how many days to consider" },
  tail:           { value: true,  what: "a durable export-events file to replay" },
  project:            { value: true,  what: "the registry project to file against" },
  title:              { value: true,  what: "what the task is called" },
  territory:          { value: true,  what: "a repository-relative path the task claims (repeatable)" },
  "territory-file":   { value: true,  what: "a file of territory claims, one per line" },
  "body-file":        { value: true,  what: "a file holding the task body, or - for stdin" },
  depth:              { value: true,  what: "trivial, standard or deep" },
  priority:           { value: true,  what: "p1 or p2" },
  "idempotency-key":  { value: true,  what: "a key that makes a re-run of this command inert" },
  "pin-territory":    { value: true,  what: "keep the territory while held, for a duration like 48h" },

  hub:            { value: false, what: "operate on the builder hub rather than a repository" },
  anyway:         { value: false, what: "file a near-twin of an existing task anyway" },
  "dry-run":      { value: false, what: "print what would happen and write nothing" },
  json:           { value: false, what: "machine-readable output" },
  force:          { value: false, what: "proceed past a refusal that is an operator judgement" },
  overwrite:      { value: false, what: "replace an existing file" },
  takeover:       { value: false, what: "take a lease whose holder is provably dead" },
  execute:        { value: false, what: "actually act, rather than observe" },
  enforce:        { value: false, what: "publish the merge policy as enforcing" },
  events:         { value: false, what: "export the event log too" },
  health:         { value: false, what: "report health only" },
  open:           { value: false, what: "open the result" },
  tick:           { value: false, what: "run a single tick and exit" },
  write:          { value: false, what: "write the change rather than printing it" },
  "as-app":       { value: false, what: "act as the GitHub App rather than the user" },
  help:           { value: false, what: "show this help" },
};
const VALUED = new Set(Object.entries(FLAGS).filter(([, f]) => f.value).map(([n]) => n));

// ── ONE walk over argv, which decides everything about it ───────────────────
//
// There were FOUR readers of `argv` -- `flag`, `opt`, the unknown-flag scan and
// `positionals` -- and each carried its own idea of what a flag is. They
// disagreed, and two of the disagreements were defects: the scan looked only at
// `--` tokens, so `-w` was never examined at all and became an unused
// positional; and `opt` returned whatever token happened to follow a flag
// without asking whether it was a value, so a trailing `--home` produced
// `undefined` and `??` turned that back into the environment the operator had
// just overridden.
//
// Neither is a missing check. Both are what a repeated resolution does -- the
// same thing this file already says about `stateFor`. So there is ONE walk, it
// emits every refusal itself, and `flag`/`opt`/`positionals` are lookups into
// its result rather than three more scans.
//
// UNKNOWN FLAGS ARE REFUSED, not ignored. Ignoring them is how `--home /tmp/x`
// silently operated on the operator's real ~/.reeve -- there was no such flag,
// so it and its value were skipped and the command ran against the live home.
// It is also how `--keeep 3` looked like it had set a retention while quietly
// using the default. A misspelled flag must not be indistinguishable from an
// absent one, because the two mean opposite things to whoever typed it.
const ARGS = (() => {
  const near = (a, b) => {                       // Levenshtein, for did-you-mean
    const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array(b.length).fill(0)]);
    for (let j = 0; j <= b.length; j++) d[0][j] = j;
    for (let i = 1; i <= a.length; i++)
      for (let j = 1; j <= b.length; j++)
        d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1,
                           d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
    return d[a.length][b.length];
  };
  const suggest = name => {
    if (!name) return "";
    const [best] = Object.keys(FLAGS)
      .map(k => [k, near(name, k)])
      // The second clause is what stops a suggestion that is not one: without
      // it `-w` was answered "did you mean --db?", because an edit distance of
      // 2 is inside the fixed floor of 2 while being the entire length of both
      // names. A suggestion has to be nearer than "wholly different".
      .filter(([k, d]) => d <= Math.max(2, Math.floor(name.length / 3)) && d < Math.max(name.length, k.length))
      .sort((x, y) => x[1] - y[1]);
    return best ? `  (did you mean --${best[0]}?)` : "";
  };

  const values = new Map(), flags = new Set(), positionals = [], errors = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("-")) { positionals.push(a); continue; }

    // Neither is a repository and neither is a flag. `--` in particular is the
    // POSIX end-of-options marker, which this CLI does not implement -- and
    // accepting it as a positional is how it would come to look implemented.
    if (a === "-" || a === "--") { errors.push(`reeve: ${a} is not a flag or a repository`); continue; }

    // A short flag is not merely unsupported, it was never LOOKED at: the scan
    // matched `--` only, so `reeve init -w` dropped `-w` into the positionals
    // and ran as though the flag were absent. Same silence, one syntax over.
    if (!a.startsWith("--")) {
      errors.push(`reeve: unknown flag ${a}${suggest(a.slice(1))}  (this CLI has no single-dash flags)`);
      continue;
    }

    const name = a.slice(2);
    if (!FLAGS[name]) {
      // `--home=/tmp/x` is a thing operators type, and `unknown flag
      // --home=/tmp/x` reads as "there is no --home". Say what is wrong instead.
      const eq = name.indexOf("=");
      const base = eq > 0 ? name.slice(0, eq) : null;
      if (base && FLAGS[base]?.value)
        errors.push(`reeve: --${base} takes its value as the next argument: --${base} ${name.slice(eq + 1)}`);
      // A BOOLEAN IS NOT GIVEN A VALUE TO COPY. The message above was emitted for
      // every known flag, so `--force=false` was answered "write --force false"
      // -- which ENABLES force and leaves `false` as an unused positional. An
      // operator who typed `=false` was asking for the opposite, and the refusal
      // talked them into it. On `restore` that is the live-daemon safety check,
      // waived by following the advice.
      else if (base && FLAGS[base])
        errors.push(`reeve: --${base} is a switch and takes no value; write --${base} to turn it on, or leave it out to turn it off. --${base}=${name.slice(eq + 1)} does not turn it off.`);
      else errors.push(`reeve: unknown flag ${a}${suggest(name)}`);
      continue;
    }

    if (!FLAGS[name].value) { flags.add(name); continue; }

    // A valued flag with no value is REFUSED, never defaulted. `--home` last on
    // the line gave `undefined`, and `--home --json` gave the string `--json`
    // as a relative directory -- so the flag that exists to stop a command
    // reaching the wrong home could send it to the wrong home, or to the live
    // one. No value this CLI takes begins with `-`: every one is a path, a
    // count, or a key=value.
    // A NUMBER is a value, not a flag: no flag this CLI has begins with a
    // digit, so `-1` is unambiguous and there is nothing to protect against.
    // Refusing it here would take `--keep -1` away from `--keep`'s own
    // validator, which says "--keep must be a positive whole number" -- a worse
    // message for the same refusal, and a property already measured and tested
    // (test/hub-doctor.test.mjs). The refusals this check exists for are a
    // token that IS a flag, and a token that is absent.
    const looksLikeFlag = v => v.startsWith("-") && !/^-?\d+(\.\d+)?$/.test(v);
    const v = argv[i + 1];
    // AN EMPTY VALUE IS A MISSING VALUE. `reeve --home "$SCRATCH"` with the
    // variable unset hands over `""`, and `resolve("")` is the CURRENT
    // DIRECTORY -- so a command that was explicitly told to use another home
    // backed up, built or restored against `<cwd>/state` instead. An operator
    // who names a home and gets nothing has said something, and it is not "use
    // wherever I happen to be standing".
    if (v === undefined || v === "") { errors.push(`reeve: --${name} expects a value: ${FLAGS[name].what}`); continue; }
    if (looksLikeFlag(v)) { errors.push(`reeve: --${name} expects a value: ${FLAGS[name].what}. Got the flag ${v}.`); continue; }
    i++;
    // Repeatable. `--set` is read as a LIST by `init`; every other valued flag
    // reads the first occurrence, which is what `opt` did before.
    if (!values.has(name)) values.set(name, []);
    values.get(name).push(v);
  }

  return { values, flags, positionals, errors };
})();

// The command, then the rest. `positionals` below excludes it, which is what
// every route already assumes: `build`/`builder` read their subcommand from
// `positionals[0]` and `doctor` scans for an owner/repo.
const cmd = ARGS.positionals[0];
if (ARGS.errors.length) {
  for (const e of ARGS.errors) console.error(e);
  console.error(`-> reeve ${cmd ?? ""} accepts: ${Object.keys(FLAGS).sort().map(f => "--" + f).join(" ")}`);
  console.error(`-> reeve --help`);
  process.exit(1);
}

const flag = n => ARGS.flags.has(n);
const opt = n => ARGS.values.get(n)?.[0] ?? null;
/** Every occurrence of a repeatable valued flag, in the order given. */
const all = n => ARGS.values.get(n) ?? [];
// A valued flag consumes the token after it, so that token is never mistaken
// for a repo name however much it looks like one.
const positionals = ARGS.positionals.slice(1);

// `--help` is dispatched HERE, above every route. It was added to the registry
// and described as "show this help" while NO route checked it, so
// `reeve restore --hub --help` selected the newest snapshot and performed the
// restore. A flag that asks a command to describe itself must never be able to
// run it.
if (flag("help")) { usage(); process.exit(0); }

// AFTER the parser, so `--home` can feed it. Order matters: this used to sit
// above `argv` and could therefore only ever read the environment.
const HOME = resolveHome(opt("home"));
// And WRITTEN BACK, before any route runs. `--home` used to change only this
// constant, so `credentialPaths()` still denied the state root named by the
// ENVIRONMENT and the canary still wrote its decoy under `~/.reeve` -- a
// sandbox that omits the tree the operator asked to isolate, and a canary
// measuring a file the policy was never about, which can answer "containment
// closed" for a policy that contains nothing. Rather than thread the home
// through the sandbox, the daemon, the canary and the App credentials -- four
// more places to forget -- the flag and the variable become ONE mechanism.
// Every consumer therefore reads it LAZILY; see src/home.mjs.
process.env.REEVE_HOME = HOME;

/** Repo identity is the remote, never the path: one repo can sit at two paths on two commits. */
/**
 * Move a store from its old short-name path to the owner-scoped one, once.
 *
 * Returns the new path either way. Copying rather than moving would leave two
 * databases that both look live, and the daemon would keep writing to whichever
 * one it opened first.
 */
function adoptLegacy(next, legacy) {
  try {
    if (!existsSync(next) && existsSync(legacy)) {
      mkdirSync(dirname(next), { recursive: true });
      for (const suffix of ["", "-wal", "-shm"]) {
        if (existsSync(legacy + suffix)) renameSync(legacy + suffix, next + suffix);
      }
      console.error(`reeve: moved ${legacy} -> ${next}`);
    }
  } catch (e) { console.error(`reeve: could not move the legacy store (${e.message}); using ${legacy}`); return legacy; }
  return next;
}

/**
 * Where one project's state lives. The single answer for every command.
 *
 * Five commands resolved this independently and one of them drifted: `doctor`
 * read `profile.state.location`, which the profile schema defines as the SIBLING
 * REPOSITORY holding a project's ledger -- "nextlyhq/nextly-ledger" -- not a path
 * on this disk. existsSync said no, doctor took that for "there is no state
 * database", and its lease check silently answered UNKNOWN for a store sitting
 * right there. A repeated resolution is a resolution that will drift again, so
 * there is now only one.
 */
const stateFor = nwo => adoptLegacy(statePathFor(HOME, nwo), legacyStatePathFor(HOME, nwo));

function detectNwo() {
  try {
    const url = execFileSync("git", ["remote", "get-url", "origin"], { encoding: "utf8" }).trim();
    const m = url.match(/[:/]([^/:]+\/[^/]+?)(?:\.git)?$/);
    return m ? m[1] : null;
  } catch { return null; }
}

function loadProfile(nwo) {
  const sidecar = join(HOME, "profiles", `${nwo}.json`);
  const inRepo = join(process.cwd(), ".ops", "profile.json");
  for (const p of [inRepo, sidecar]) {
    if (!existsSync(p)) continue;
    let raw;
    try { raw = JSON.parse(readFileSync(p, "utf8")); }
    catch (e) { console.error(`reeve: ${p} is not valid JSON — ${e.message}`); process.exit(1); }
    const profile = withDefaults(raw);
    const r = validate(profile);
    if (!r.ok) {
      // A profile that does not validate is refused, never partially applied: a
      // half-loaded profile is how a gate ends up judging the wrong check name.
      console.error(`reeve: ${p} is invalid`);
      for (const e of r.errors) console.error("  error:", e);
      process.exit(1);
    }
    for (const w of r.warnings) console.error("  warn:", w);
    return { path: p, ...profile };
  }
  return null;
}

switch (cmd) {
  case "doctor": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve doctor: no repo. Pass owner/repo or run inside a git checkout."); process.exit(1); }
    const profile = loadProfile(nwo) ?? {};
    // Absent is a real answer here -- a project reeve has never run against has no
    // store yet -- so doctor reports on what it finds rather than refusing to run.
    const dbPath = opt("db") ?? stateFor(nwo);
    const db = dbPath && existsSync(dbPath) ? open(dbPath) : null;
    // Documented in docs/github-app-setup.md as the step that proves the App works.
    const appCheck = flag("as-app") ? await checkAppIdentity(nwo) : null;
    const result = runDoctor({
      nwo, profile, db, appCheck,
      pluginCacheRoot: opt("plugin-cache"),
      repoPluginDir: opt("plugin-repo"),
      // Where the daemon records its canary: the same HOME the daemon logs to.
      stateDir: HOME,
    });
    // The home doctor is reporting FROM, and `resolveHome()` rather than
    // `HOME` on purpose: this is the answer every module below will get, which
    // is the value that can be wrong. The single most confusing thing about this
    // CLI has been which home a command actually acted on -- it is how a hub
    // came to exist in the operator's real ~/.reeve -- and "what is actually
    // true right now" is precisely doctor's job.
    const home = resolveHome();
    if (flag("json")) console.log(JSON.stringify({ home, ...result }, null, 2));
    else console.log(render(result, nwo) + `\n\nhome  ${home}`);
    if (!profile.path && !flag("json")) {
      console.log(`\nno profile for ${nwo}. Checks that need one were skipped.\n-> reeve init`);
    }
    process.exit(result.exitCode);
  }
  case "backup": {
    if (flag("hub")) {
      // snapshotAll walks every store INCLUDING the hub (Task 8), so this is the
      // whole-machine backup, not a hub-only one. That is deliberate: an operator
      // reaching for `backup --hub` is protecting the machine, and taking the
      // per-repo stores at the same moment costs nothing and keeps the set
      // mutually consistent.
      const root = opt("to") ?? join(HOME, "backups");
      // VALIDATED before anything is written. `Number()` alone accepts `0`,
      // negatives, fractions and `NaN`, and each erases every recovery point
      // while the command prints `snapshot hub -> ...` and exits 0. `keep: 0`
      // prunes to nothing, and `slice(NaN)` is `slice(0)` in JavaScript -- so a
      // typo like `--keep aa` deletes the entire backup set. Measured: all four
      // of `0`, `-1`, `aa` and `2.5` reported success. A malformed option must
      // not be the most destructive thing this command can do.
      const keepRaw = opt("keep");
      // `== null`, not `=== undefined`: this CLI's `opt()` returns NULL for an
      // absent flag, so a strict undefined check rejected the DEFAULT path and
      // broke every plain `backup --hub`. Found by running the command, not by
      // reading the validation.
      const keep = keepRaw == null ? 14 : Number(keepRaw);
      if (!Number.isInteger(keep) || keep < 1)
        die(`reeve backup --hub: --keep must be a positive whole number of snapshots to retain, ` +
            `got ${JSON.stringify(keepRaw)}.\n-> omit it for the default of 14`);
      const results = snapshotAll(HOME, root, { keep });
      for (const r of results)
        console.log(r.deferred ? `deferred ${r.nwo}: ${r.why}`
                  : r.ok       ? `snapshot ${r.nwo} -> ${r.path}`
                  :              `FAILED   ${r.nwo}: ${r.why}`);
      // `deferred` is neither, and must not fail the exit status. A same-second
      // race with another daemon is not a backup failure, and a command that
      // exits non-zero for one teaches an operator to stop reading its output --
      // which is the real cost, because this is the command they run when
      // something has already gone wrong.
      // The HUB specifically, not "did anything fail". `everyStore` returns only
      // files that exist, so a missing hub is simply absent from `results` -- and
      // an exit status computed from failures answers 0 for a run that backed up
      // nothing at all. This is the command an operator reaches for to protect
      // the authority database, including in the minutes after deleting it by
      // accident, and it must not answer "done" then.
      const hub = results.find(r => r.nwo === "hub");
      if (!hub)
        die(`reeve backup --hub: there is no hub database at ${hubPathFor(HOME)}, so nothing was backed up.\n` +
            `-> reeve build run creates it`);
      if (!hub.ok)
        die(`reeve backup --hub: the hub snapshot failed: ${hub.why}`);
      // `ok` alone now: a deferred result is `ok`, because another process
      // published it and that is not this command's failure.
      process.exit(results.some(r => !r.ok) ? 1 : 0);
    }
    // ...the existing per-repo backup, unchanged, below.
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve backup: no repo."); process.exit(1); }
    const dbPath = opt("db") ?? stateFor(nwo);
    if (!existsSync(dbPath)) { console.error(`reeve backup: no state at ${dbPath}`); process.exit(1); }
    const root = opt("to") ?? join(HOME, "backups");
    const db = open(dbPath);
    if (flag("events")) {
      const p = opt("out") ?? join(root, `${nwo.replace("/", "-")}-events.jsonl`);
      mkdirSync(dirname(p), { recursive: true });
      const r = exportEvents(db, p);
      console.log(r.ok ? `${r.count} event(s) -> ${r.path}` : `failed: ${r.why}`);
      process.exit(r.ok ? 0 : 1);
    }
    const r = snapshot(db, root, nwo);
    console.log(r.ok ? `snapshot -> ${r.path}` : `failed: ${r.why}`);
    process.exit(r.ok ? 0 : 1);
  }

  case "export-events": {
    if (!flag("hub")) die("usage: reeve export-events --hub <file>");
    // positionals[0] is the destination: `export-events` is the subcommand and is
    // not itself a positional under this parser, so index 1 was always undefined
    // and the command could never run.
    const out = positionals[0] ?? die("usage: reeve export-events --hub <file>");
    // RAW and read-only, not openHub: exporting is a read, and openHub would
    // MIGRATE the very database the operator is trying to get history out of --
    // quite possibly the one they are exporting because they do not trust it.
    // The FIFTH site of the version-zero class, and one the review round did
    // not name -- found by running every hub route against an interrupted store
    // rather than by fixing the site that was reported. `hub_event` does not
    // exist at version 0, so this died with an uncaught `no such table` on the
    // one command an operator runs to rescue history from a hub they no longer
    // trust.
    if (completedVersion(hubPathFor(HOME)) < 1)
      die(`reeve export-events --hub: the hub's first migration never completed, so it holds no event log\n` +
          `  hub      ${hubPathFor(HOME)}\n` +
          `  recover  reeve build run finishes it, or reeve restore --hub --force installs a snapshot`);
    const db = new DatabaseSync(hubPathFor(HOME), { readOnly: true });
    const rows = db.prepare("SELECT seq,at,kind,task,payload FROM hub_event ORDER BY seq").all();
    // The FOOTER, appended last, is the whole truncation detector -- and an
    // earlier revision of this plan described it here and then wrote only the
    // event lines, so every `restore --hub --tail` was refused for a footer no
    // exporter had ever produced. It is written, not described.
    const lines = rows.map(r => JSON.stringify(r));
    const body = lines.length ? lines.join("\n") + "\n" : "";
    const manifest = {
      count: rows.length,
      first: rows.length ? rows[0].seq : null,
      last: rows.length ? rows[rows.length - 1].seq : null,
      // Over the EVENT LINES ONLY, so a reader can recompute it without having
      // to strip the footer that carries it out of its own input.
      sha256: createHash("sha256").update(body).digest("hex"),
    };
    // Body first, footer last, one write. Order is the point: a copy that is cut
    // short loses the footer before it loses any event, which is what turns
    // "the file ends here" into a claim that can be false.
    //
    // And published TEMP-THEN-RENAME. `writeFileSync` truncates the destination
    // before it writes a byte, so refreshing an existing tail destroyed the last
    // valid one FIRST: a kill or a full disk then left a partial file with no
    // manifest, and a later restore permanently lost every post-snapshot event
    // that tail was protecting. The file this command exists to produce is the
    // one an operator reaches for after losing the hub, so it is the last file
    // in the system that may be replaced in place.
    //
    // Same directory, so the rename is within one filesystem and therefore
    // atomic; unique by pid, so two exports to one path cannot share a temp.
    // `fsync` before the rename because a rename is atomic with respect to the
    // NAME, not to the bytes: without it a crash can publish a name for content
    // that never reached the disk.
    const tmp = `${out}.tmp-${process.pid}`;
    try {
      const fd = openSync(tmp, "w");
      try {
        writeSync(fd, body + JSON.stringify({ _manifest: manifest }) + "\n");
        fsyncSync(fd);
      } finally { closeSync(fd); }
      renameSync(tmp, out);
    } catch (e) {
      // The previous tail is still whole -- that is the point of the temp file --
      // so the refusal says so rather than leaving the operator to guess.
      try { rmSync(tmp, { force: true }); } catch {}
      die(`reeve export-events --hub: could not write ${out} (${e.message}); the previous export is untouched`);
    }
    console.log(`exported ${rows.length} hub events to ${out}`);
    break;
  }

  case "restore": {
    if (flag("hub")) {
      // DEEP for the restore path. Cheap validation reads markers and the table
      // set; a corrupt data page or a foreign-key violation passes all of it, so
      // the newest candidate was selected here and then rejected by restoreHub's
      // own deep check -- with no fallthrough to the next older snapshot, which
      // is precisely the fallback this selection advertises. Paid once, on the
      // file about to be installed.
      const from = opt("from") ?? latestSnapshot(opt("to") ?? join(HOME, "backups"), "hub", { deep: true });
      if (!from) die(`reeve restore --hub: no usable snapshot under ${opt("to") ?? join(HOME, "backups")}`);
      // The durable tail, written by `reeve export-events --hub`. Optional: a
      // restore with no tail is still correct, it just recovers less.
      let tail = null;
      const tailPath = opt("tail");
      if (tailPath) {
        if (!existsSync(tailPath)) die(`reeve restore --hub: no tail file at ${tailPath}`);
        // The last line is the MANIFEST, not an event. Splitting it off here is
        // what makes `manifest.count === rawTail.length` a comparison rather
        // than an off-by-one, and leaving it in the array would replay a footer
        // into `hub_event` as if it were history.
        const rawLines = readFileSync(tailPath, "utf8").split("\n").filter(Boolean);
        // PARSED WITH A REFUSAL, not a throw. A partial copy is the likeliest
        // damage to a recovery tail -- it is the case the manifest check exists
        // to diagnose -- and a file that stops mid-line got there first, as an
        // uncaught SyntaxError with a stack trace, from the one command an
        // operator runs when the hub is already gone.
        const parsed = [];
        for (const [i, l] of rawLines.entries()) {
          try { parsed.push(JSON.parse(l)); }
          catch (e) {
            die(`reeve restore --hub: ${tailPath} is not a valid event export -- line ${i + 1} of ${rawLines.length} ` +
                `could not be parsed (${e.message})\n` +
                `  line     ${l.length > 120 ? l.slice(0, 120) + "…" : l}\n` +
                `  recover  re-export it with reeve export-events --hub; a copy that stopped part way ` +
                `cannot be told from a complete one by its length`);
          }
        }
        const hasFooter = parsed.length > 0 && parsed[parsed.length - 1]?._manifest != null;
        const footer = hasFooter ? parsed.pop()._manifest : null;
        if (hasFooter) rawLines.pop();
        // An array WITH properties, because that is the shape `restoreHub`
        // already consumes: it indexes `suppliedTail` as the event list and
        // reads `suppliedTail.manifest` beside it.
        tail = parsed;
        tail.manifest = footer;
        // The digest the FILE actually carries, computed over its RAW BYTES and
        // never over re-serialised objects. `JSON.stringify(JSON.parse(x)) === x`
        // is a property of today's rows, not a guarantee, and a digest that
        // depends on it would fail for a reason no operator could diagnose.
        // `restoreHub` cannot compute this itself -- by the time it has the
        // parsed events the bytes are gone -- so the reader of the file reports
        // what it observed and the validator decides.
        tail.sha256 = createHash("sha256")
          .update(rawLines.length ? rawLines.join("\n") + "\n" : "").digest("hex");
      }
      const r = restoreHub(from, hubPathFor(HOME), {
        isAlive: isSameProcess, pid: process.pid, lstart: readStart(process.pid),
        force: flag("force"), tail });
      if (!r.ok) {
        console.error(`refused: ${r.why}`);
        for (const h of r.holders ?? []) console.error(`  held by ${h.what} pid ${h.pid} (${h.command})`);
        process.exit(1);
      }
      console.log(`restored ${from} -> ${hubPathFor(HOME)} (replayed ${r.replayed} of ${r.tail} tail events)`);
      // A recovery whose live source could not be read, with no `--tail`
      // supplied, restored the snapshot and NOTHING after it -- and said exactly
      // what a recovery that inspected a genuinely empty tail says. The two are
      // not the same event and must not print the same line: one lost every
      // event since the snapshot, the other lost none. `r.quarantined` is the
      // tell, because it is set only on the unreadable path; an absent hub is
      // caught by the same condition through `r.tail === 0` with no `--tail`.
      if (!r.liveTailRead && !opt("tail"))
        console.warn(
          `WARNING: the live hub could not be read, and no --tail was supplied, so nothing after the\n` +
          `snapshot was recovered. If a durable export exists, re-run with --tail <export> to carry\n` +
          (r.quarantined ? `those events forward. The unreadable database is kept at ${r.quarantined}.` : `those events forward.`));
      process.exit(0);
    }
    // ...the existing per-repo restore, unchanged, below.
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve restore: no repo."); process.exit(1); }
    const from = opt("from") ?? latestSnapshot(opt("to") ?? join(HOME, "backups"), nwo);
    if (!from) { console.error(`reeve restore: no snapshot for ${nwo}`); process.exit(1); }
    const dbPath = opt("db") ?? stateFor(nwo);
    const r = restore(from, dbPath, { overwrite: flag("overwrite"), force: flag("force") });
    console.log(r.ok ? `restored ${from} -> ${dbPath}` : `refused: ${r.why}`);
    process.exit(r.ok ? 0 : 1);
  }

  case "init": {
    // --set key=value, repeatable. Answers only the questions detection could not
    // settle; everything else comes from the repo and is not negotiable.
    // From the ONE parse, not a fifth walk over argv. The old loop read its
    // own `--set` tokens and so disagreed with the parser about what a value
    // is: a missing value became the empty string and reported "expects
    // key=value, got \"\"" where the parser now refuses the flag by name.
    const answers = {};
    for (const kv of all("set")) {
      const eq = kv.indexOf("=");
      if (eq < 0) { console.error(`reeve init: --set expects key=value, got ${JSON.stringify(kv)}`); process.exit(1); }
      answers[kv.slice(0, eq)] = kv.slice(eq + 1);
    }
    // `home` explicitly, not just via the environment: init WRITES, and a
    // function whose destination comes from an ambient variable is one whose
    // destination is invisible at the call site.
    const r = init({ root: process.cwd(), answers, write: flag("write"), home: HOME });
    console.log(r.output);
    process.exit(r.code);
  }

  case "shadow": {
    // The gate before PR-5. It answers one question -- has the derived review
    // view agreed with the live read, on real pull requests, for long enough --
    // and shows every divergence rather than a pass/fail, because each one has to
    // be explained in writing before the switch is thrown.
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve shadow: no repo."); process.exit(1); }
    const dbPath = opt("db") ?? stateFor(nwo);
    if (!existsSync(dbPath)) { console.error(`reeve shadow: no state at ${dbPath}`); process.exit(1); }
    const db = open(dbPath);
    const { streak, divergences } = await import("../src/review/shadow.mjs");
    const need = Number(opt("days") ?? 5);
    const sk = streak(db, nwo);
    const bad = divergences(db, nwo);

    console.log(`review shadow  ${nwo}`);
    console.log(`  ${sk.days} consecutive day(s) agreeing, over ${sk.comparisons} comparison(s)`);
    console.log(`  target: ${need} days with zero divergence`);
    if (bad.length) {
      console.log(`\n  divergences to explain (${bad.length}):`);
      for (const d of bad) {
        console.log(`    ${d.day}  #${d.pr}  ${d.agreements}/${d.comparisons} agreed`);
        if (d.last_divergence) console.log(`        ${d.last_divergence}`);
      }
    }
    const rows = db.prepare(
      `SELECT day, SUM(comparisons) c, SUM(agreements) a, SUM(incomparable) i
         FROM review_shadow WHERE nwo=? GROUP BY day ORDER BY day DESC LIMIT 10`).all(nwo);
    if (rows.length) {
      console.log("\n  by day:");
      for (const r of rows) {
        console.log(`    ${r.day}  ${r.a}/${r.c} agreed` +
                    (r.i ? `, ${r.i} not comparable` : "") +
                    (r.c && r.a === r.c ? "  ok" : r.c ? "  DIVERGED" : "  nothing compared"));
      }
    } else {
      console.log("\n  nothing compared yet.");
    }
    // The streak already EXCLUDES any day that diverged, so N consecutive clean
    // days ending today is the whole condition. Also requiring that no divergence
    // has ever been recorded would let one bad day -- today's, caused by a bug
    // since fixed -- block the gate permanently, which is a gate that can only
    // ever say no.
    //
    // Old divergences stay listed above. They are history to read, not a veto.
    process.exit(sk.days >= need ? 0 : 3);
  }

  // These four share one body below. A new subcommand must get its OWN block
  // above -- inserted between these labels and the body, its unconditional exit
  // captures all of them, which is how `shadow` silently broke `status` for a day.
  case "status":
  case "statusline":
  case "dash":
  case "why": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    const short = nwo ? nwo.split("/")[1] : null;   // display only, never a path
    // Same resolution as the daemon, or the two would read different databases:
    // one would adopt the legacy store and the other would keep opening it in
    // place, and they would drift without either ever failing.
    const dbPath = opt("db") ?? (nwo ? stateFor(nwo) : null);
    if (!dbPath || !existsSync(dbPath)) {
      // A statusline must never be noisy or slow, so it degrades to one quiet word.
      if (cmd === "statusline") { console.log("reeve: no state"); process.exit(0); }
      console.error(`reeve ${cmd}: no state database${dbPath ? ` at ${dbPath}` : ""}`); process.exit(1);
    }
    const db = open(dbPath);

    if (cmd === "statusline") { console.log(statusline(db, { nwo })); process.exit(0); }
    if (cmd === "dash") {
      const out = opt("out") ?? dashPathFor(HOME, nwo);
      const health = flag("health") && nwo ? { clean: cleanMergeRate(nwo, Number(opt("last") ?? 20)) } : {};
      writeDash(out, { nwo, state: readState(db), health });
      console.log(out);
      if (flag("open")) { try { execFileSync("open", [out]); } catch { /* not macOS */ } }
      process.exit(0);
    }
    if (cmd === "why") {
      const target = positionals.find(a => /^#?\d+$/.test(a) || a.startsWith("pr:"));
      if (!target) { console.error("reeve why <pr-number>"); process.exit(1); }
      console.log(why(db, target));
      process.exit(0);
    }

    const state = readState(db);
    // The health band costs network calls, so it is opt-in on a screen that must
    // stay instant by default.
    const health = flag("health") && nwo
      ? { clean: cleanMergeRate(nwo, Number(opt("last") ?? 20)) }
      : { clean: { ok: false, why: "pass --health to measure (costs API calls)" } };
    if (flag("json")) console.log(JSON.stringify({ state, health }, null, 2));
    else console.log(renderStatus({ nwo, state, health }));
    process.exit(0);
  }

  // Measure the worker boundary on demand, without arming anything.
  //
  // The canary is the evidence dispatch rests on, and until now the only way to
  // produce it was to turn --execute on and wait for a tick that wanted a
  // worker. That is the wrong order: the measurement is what should decide
  // whether to arm, so it has to be available before.
  //
  // It measures the SCRATCH-HOME arrangement whatever the profile currently
  // declares, because that is the question being asked -- "would a worker be
  // contained here?" -- and the profile's isolation setting only governs whether
  // the daemon may act on the answer. The sandbox policy is generated from the
  // profile as it stands, so the record is the one `reeve doctor` R-14 reads and
  // the one the daemon's own cache will match.
  case "canary": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve canary: no repo. Pass owner/repo or run inside a git checkout."); process.exit(1); }
    const profile = loadProfile(nwo);
    if (!profile) { console.error(`reeve canary: no profile for ${nwo}.\n-> reeve init`); process.exit(1); }
    const logPath = resolve(opt("log") ?? join(HOME, "reeve.log"));
    const declared = profile.worker?.isolation ?? "none";
    console.log(`reeve canary  ${nwo}\n`);
    console.log("running a throwaway worker under the policy this profile generates.");
    console.log("this is a real model call and takes minutes. nothing is dispatched and nothing is published.\n");
    const asked = { ...profile, worker: { ...(profile.worker ?? {}), isolation: "scratch-home" } };
    const v = await measuredContainment({ dbPath: resolve(opt("db") ?? stateFor(nwo)), logPath, canaryStateDir: HOME }, asked, nwo, logPath);
    const c = v.canary ?? {};
    console.log(`\ncredentialRead : ${v.credentialRead}`);
    console.log(`canary         : ${c.skipped ? "NOT RUN" : c.ok ? "PASSED" : "FAILED"}${c.id ? ` (${c.id})` : ""}`);
    if (c.why) console.log(`                 ${c.why}`);
    if (v.why && v.credentialRead !== "closed") console.log(`why            : ${v.why}`);
    if (declared !== "scratch-home")
      console.log(`\nthe profile declares worker.isolation: '${declared}', so the daemon still refuses to dispatch.\n-> set it to 'scratch-home' to act on this measurement`);
    console.log(`\nrecorded for \`reeve doctor\` R-14 under ${HOME}`);
    process.exit(v.credentialRead === "closed" ? 0 : 1);
  }

  case "builder": {
    // `positionals[0]`, not `process.argv[3]`: a raw index counts flags as
    // words, so `reeve builder --json doctor` refused a legitimate command.
    if (positionals[0] !== "doctor") die("usage: reeve builder doctor [--json]");
    // READ-ONLY, like every doctor path: a reporter that can write what it
    // reports can agree with itself.
    const p = hubPathFor(HOME);
    if (!existsSync(p)) {
      const none = [{ id: "H-0", severity: "fail", classification: "configuration",
                      title: "there is no hub database", detail: p,
                      action: "reeve build run creates it" }];
      console.log(flag("json") ? JSON.stringify(none, null, 2) : renderHub(none));
      process.exit(1);
    }
    // The open and the version probe TOGETHER, in a try. A hub that exists but
    // cannot be opened -- or cannot answer for its schema version -- is an
    // ordinary diagnostic scenario, and it is the scenario `builder doctor`
    // exists for. Throwing an uncaught SQLite error produces no finding and no
    // JSON at all, so the one command an operator runs to find out what is wrong
    // answers with a stack trace. `selfAudit` in this same task already treats
    // this as a structured integrity fault; doctor has to agree with it.
    let db;
    try {
      db = new DatabaseSync(p, { readOnly: true });
      db.prepare("SELECT COALESCE(max(version),0) v FROM schema_version").get();
    } catch (e) {
      try { db?.close(); } catch {}
      const broken = [{ id: "H-0", severity: "fail", classification: "configuration",
        title: "the hub database cannot be read", detail: `${p}: ${e.message}`,
        action: "reeve restore --hub, and pass --tail from a durable export-events --hub if you have one" }];
      console.log(flag("json") ? JSON.stringify(broken, null, 2) : renderHub(broken));
      process.exit(1);
    }
    // The forward-version refusal, here too. `build status`, `build run` and
    // both restore paths refuse a store above this binary's version; doctor read
    // one and answered anyway, running queries shaped for the older schema. Its
    // answers are then confidently wrong in the direction that matters most --
    // omitted authority checks and passes for things it cannot see -- which is
    // worse from the command an operator runs precisely to find out whether
    // anything is wrong.
    {
      const v = db.prepare("SELECT COALESCE(max(version),0) v FROM schema_version").get().v;
      if (v > HUB_SCHEMA_VERSION) {
        const stale = [{ id: "H-0", severity: "fail", classification: "configuration",
          title: "the hub is newer than this reeve", detail: `hub is at schema version ${v}; this reeve knows ${HUB_SCHEMA_VERSION}`,
          action: "upgrade reeve; this binary cannot report on a schema it does not know" }];
        console.log(flag("json") ? JSON.stringify(stale, null, 2) : renderHub(stale));
        process.exit(1);
      }
      // And BELOW, which this route did not ask. `hubFindings` queries
      // `repo_gate_state` immediately, so an interrupted first migration made
      // the one command an operator runs to find out what is wrong answer with
      // an uncaught `no such table` stack trace instead of a finding.
      if (v < 1) {
        const half = [{ id: "H-0", severity: "fail", classification: "configuration",
          title: "the hub's first migration never completed", detail: `${p}: schema_version records no completed migration`,
          action: "reeve build run finishes it, or reeve restore --hub --force installs a snapshot" }];
        console.log(flag("json") ? JSON.stringify(half, null, 2) : renderHub(half));
        process.exit(1);
      }
    }
    // Read ONCE, and its failure is carried rather than swallowed. H-7 below is
    // what stops an unreadable registry from reading as an empty one.
    const registry = registryProjects(HOME);
    let findings;
    try {
      findings = hubFindings(db, { root: opt("backups") ?? join(HOME, "backups"),
                                   now: Math.floor(Date.now() / 1000),
                                   // The REGISTRY's projects, not the rows the table
                                   // happens to hold. H-4 exists to report a project
                                   // that has NEVER acquired a repo_gate_state row --
                                   // unsafe authority, silently. Defaulting to []
                                   // makes the CLI report only what is already
                                   // present, so the exact absent-row case this task
                                   // calls unsafe is the one case it cannot see.
                                   projects: registry.projects,       // see registryProjects below
                                   // Whether the registry was READ, not what it
                                   // contained. `projects: []` means "none
                                   // listed" and "could not be read" alike, and
                                   // only the first is a reason to stop
                                   // reporting a gate-state row.
                                   projectsKnown: registry.error == null,
                                   // The NEWEST on-disk candidate is reported
                                   // separately from the one restore would pick.
                                   // `latestSnapshot` skips a candidate that
                                   // fails cheap validation and returns an older
                                   // good file -- which is right for restore and
                                   // wrong for doctor: H-1/H-2/H-3 then describe
                                   // the fallback and report `pass`, so a broken
                                   // newest backup is invisible for as long as
                                   // the older recovery point stays fresh. That
                                   // is the exact window in which the next backup
                                   // fails too and nobody is told.
                                   newestCandidate: (nwo) => {
                                     // `slug` is module-private in src/backup.mjs
                                     // and is NOT exported by Task 8. Evaluated
                                     // before the try below, so an installation
                                     // with no backup directory crashed rather
                                     // than returning findings. `latestSnapshot`
                                     // already owns this mapping, so the CLI asks
                                     // it for the directory instead of
                                     // reimplementing the slug rule -- two
                                     // spellings of one convention is how they
                                     // drift.
                                     const dir = dirname(latestSnapshot(
                                       opt("backups") ?? join(HOME, "backups"), nwo)
                                       ?? join(opt("backups") ?? join(HOME, "backups"), "hub", "0.db"));
                                     let f;
                                     try { f = readdirSync(dir).filter(n => /^\d+\.db$/.test(n))
                                             .sort((a, b) => Number(b.split(".")[0]) - Number(a.split(".")[0]))[0]; }
                                     catch { return null; }
                                     if (!f) return null;
                                     const path = join(dir, f);
                                     // The epoch in the FILENAME, not the mtime.
                                     //
                                     // `basename` MUST be added to bin/reeve's
                                     // node:path import, which reads
                                     // `{ join, dirname, resolve }` on
                                     // `16769e7` (bin/reeve:18) and becomes
                                     // `{ join, dirname, resolve, basename }`.
                                     // Stated as an instruction rather than a
                                     // parenthetical because an unimported
                                     // `basename` has already shipped once in
                                     // this programme: both call sites below
                                     // throw ReferenceError at the first
                                     // `builder doctor` invocation, which is
                                     // the whole command.
                                     // `snapshot()` writes `<epoch>.db`, and that
                                     // is the authoritative creation time; a copy
                                     // back from off-device storage carries a
                                     // fresh mtime, so H-1 would call a days-old
                                     // recovery point fresh for another 24 hours
                                     // -- and the moment an operator most needs
                                     // this answer is right after restoring from
                                     // off-device.
                                     return { path, at: Number(basename(path).split(".")[0]),
                                              ...validateSnapshot(path, { kind: "hub", expectVersion: HUB_SCHEMA_VERSION, deep: true }) };
                                   },
                                   snapshotFor: (nwo) => {
                                     // Same filename-epoch rule as
                                     // `newestCandidate` below. Fixing one and
                                     // not the other left H-1 reading a copy
                                     // time for the snapshot a restore would
                                     // actually use -- the one that matters most.
                                     const s = latestSnapshot(opt("backups") ?? join(HOME, "backups"), nwo, { deep: true });
                                     // DEEP, and the only deep call on this path. `builder doctor` is an
                                     // operator command run on demand, not a loop, and H-2's whole claim
                                     // is that the newest snapshot would restore. The cheap validation
                                     // returns `integrity: null`, so labelling it "integrity_check
                                     // passed" reports a green H-2 for a snapshot with page corruption
                                     // outside the schema pages -- the one failure H-2 exists to find.
                                     // The epoch from the FILENAME, like
                                     // `newestCandidate`. The comment above
                                     // claimed this rule and the line below
                                     // still read `statSync(s).mtimeMs`, which
                                     // is the copy time -- so H-1 called a
                                     // days-old snapshot restored from
                                     // off-device fresh for another 24 hours,
                                     // at exactly the moment an operator most
                                     // needs the true age.
                                     return s ? { path: s, at: Number(basename(s).split(".")[0]),
                                                  ...validateSnapshot(s, { kind: "hub", expectVersion: HUB_SCHEMA_VERSION, deep: true }) } : null;
                                   } });
    } finally { db.close(); }
    // H-7 goes in BEFORE anything is printed. Unshifting after the render set the
    // exit status correctly and told the operator nothing: neither the JSON nor
    // the human output carried the registry error that explains the failure, and
    // every suppressed H-4 stayed invisible. A finding that does not reach the
    // output is not a finding.
    if (registry.error)
      findings.unshift({ id: "H-7", severity: "fail", classification: "configuration",
        title: "the project registry could not be read",
        detail: registry.error,
        // THE PATH IT ACTUALLY READ, not the default. `detail` carries
        // `registry.error`, which names the real file; the action named
        // `~/.reeve` regardless, so under `--home` or a custom REEVE_HOME an
        // operator could follow it exactly and stay broken. Third instance of
        // this shape today -- a remediation reconstructing what the diagnosis
        // already knew.
        action: `fix or create ${join(HOME, "projects.json")}; until then H-4 cannot report a missing gate-state row` });
    console.log(flag("json") ? JSON.stringify(findings, null, 2) : renderHub(findings));
    // The CLI's existing doctor convention, documented at `bin/reeve:364`:
    // 0 ok, 1 broken, 3 degraded. Exiting 0 on warnings tells automation that a
    // stale snapshot, unmeasured provider limits, expired requests or no
    // off-device copy are all healthy -- which is the reading the `warn`
    // severity exists to prevent.
    // H-7 is emitted at the ROUTE rather than inside hubFindings, because
    // hubFindings takes the project list as an input and cannot tell an empty
    // list from a failed read -- that indistinguishability is the defect.
    // Severity `fail`, not `warn`: with no expected projects every absent-row
    // H-4 is suppressed, so this one finding stands in for an unknown number of
    // hidden ones. It is unshifted above, before the render.
    process.exit(findings.some(f => f.severity === "fail") ? 1
               : findings.some(f => f.severity === "warn") ? 3 : 0);
  }

  case "task": {
    const sub = positionals[0];
    if (sub !== "file") {
      console.error("reeve task: the only subcommand is `file`");
      console.error('-> reeve task file --project <p> --title "..." --territory <path>');
      process.exit(1);
    }
    const { fileTask, pinSeconds } = await import("../src/build/taskfile.mjs");
    const { loadRegistry, registryIo } = await import("../src/build/registryio.mjs");
    const { CAPABILITY_NAMES, capabilityOn } = await import("../src/build/capabilities.mjs");
    const { openHub } = await import("../src/build/hubdb.mjs");

    const reg = loadRegistry(HOME);
    if (reg.error) { console.error(`reeve task: ${reg.error}`); process.exit(1); }
    // `resolveSnapshot` wants `{version, projects: {<name>: entry}}`, and the
    // loader ALREADY returns exactly that beside the array the doctor and the
    // tick iterate. Rebuilding it from the array here would drop the version --
    // which is one of the eleven facts admission requires, so every filing would
    // be refused for an incomplete snapshot.
    const registry = reg.registry;

    const pin = pinSeconds(opt("pin-territory"));
    if (pin?.refusal) { console.error(`reeve task: ${pin.refusal}`); process.exit(1); }

    // `loadProfile` is keyed on the NWO, not on the home, so the project has to
    // resolve in the registry before the switches can be read; a `--project`
    // that names nothing is refused here rather than reaching `resolveSnapshot`
    // with a profile of `null` already in hand.
    const project = opt("project");
    const entry = registry.projects[project];
    if (!entry) {
      console.error(`reeve task: ${JSON.stringify(project)} is not a project in the registry`);
      console.error(`-> known projects: ${Object.keys(registry.projects).join(", ") || "(none)"}`);
      process.exit(1);
    }
    const profile = loadProfile(entry.nwo);
    if (!profile) { console.error(`reeve task: no profile for ${entry.nwo}`); process.exit(1); }

    // BARE NAMES, read through the validated reader. `capabilitiesFrom` returns
    // full dotted keys and omits any the profile never declared, so a plan
    // printed from it would show `builder.capabilities.observe` and silently
    // drop the switches that matter most -- the ones nobody has set yet.
    // `capabilityOn` throws on a name the schema does not declare, so a typo
    // here cannot read as "off".
    const switches = Object.fromEntries(
      CAPABILITY_NAMES.map(n => [n, capabilityOn(profile, n)]));

    // Repeatable, already: the argv walk pushes every occurrence of a valued
    // flag and `all` returns the list. `--territory-file` appends to the same
    // list rather than replacing it, so the two flags compose.
    const fromFile = opt("territory-file")
      ? readFileSync(opt("territory-file"), "utf8").split("\n").map(s => s.trim()).filter(Boolean) : [];

    const db = openHub(hubPathFor(HOME));
    const r = await fileTask({
      db, registry, project, title: opt("title"),
      territory: [...all("territory"), ...fromFile],
      body: opt("body-file")
        ? readFileSync(opt("body-file") === "-" ? 0 : opt("body-file"), "utf8") : null,
      depth: opt("depth"), priority: opt("priority") ?? "p2",
      idempotencyKey: opt("idempotency-key"), anyway: flag("anyway"),
      dryRun: flag("dry-run"), switches,
      io: registryIo(HOME, project, entry, {}), isAlive: isSameProcess,
      pid: process.pid, lstart: readStart(process.pid),
    });
    db.close();
    if (flag("json")) console.log(JSON.stringify(r, null, 2));
    else if (!r.ok) console.error(`reeve task: ${r.refusal}`);
    else if (r.dryRun) console.log(`would file in ${r.plan.project}: ` +
      `${r.plan.territory.map(t => t.path || "(repository root)").join(", ")}` +
      (r.plan.conflicts.length ? `\nconflicts:\n  ${r.plan.conflicts.join("\n  ")}` : ""));
    else console.log(`${r.task} FILED${r.replayed ? " (already filed; nothing was done)" : ""}`);
    process.exit(r.ok ? 0 : 1);
  }

  case "build": {
    // HOME is the value bin/reeve already resolved. An earlier draft called
    // `HOME`, which is not defined in this file, so every build run and build
    // status threw before reaching the lease -- the two commands this task
    // exists to add.
    //
    // That resolution is `process.env.REEVE_HOME ?? join(homedir(), ".reeve")`
    // and NOTHING ELSE -- `bin/reeve:45`. There is no `--home` flag, and this
    // comment claimed one. Unknown flags are IGNORED rather than refused, so
    // `reeve build run --home /tmp/x` silently operates on the operator's real
    // home; that is how the first run of Task 7's CLI test created a hub and a
    // singleton lease in `~/.reeve`. Scope a test or an operator to a different
    // home with the ENVIRONMENT VARIABLE. A real `--home`, and a refusal for
    // unknown flags, belong to the CLI surface pass, not to this task.
    // `positionals[0]`, not `process.argv[3]` -- see `builder`: a raw index
    // makes `reeve build --takeover run` look like a typo.
    const sub = positionals[0];
    if (sub !== "run" && sub !== "status")
      die(`usage: reeve build run [--takeover] | reeve build status`);
    // `status` opens READ-ONLY and RAW; only `run` may open through openHub.
    // openHub applies forward migrations, and a migration is a write -- so once
    // migration 2 exists, `reeve build status` would silently upgrade the
    // database under a live builder, or during a restore, while holding neither
    // a writer lease nor assertWritable. A read command must not be able to
    // change what it reports.
    // `status` on a fresh home, before any `build run`, must REPORT rather than
    // throw: DatabaseSync with readOnly on a path that does not exist raises an
    // uncaught SQLite open error, and "unable to open database file" is not an
    // answer to "is the builder running".
    // `DatabaseSync` is imported by THIS task, not by Task 9. Both routes below
    // construct one, and the fresh-home guard immediately above is what hid the
    // omission: on a machine with no hub yet, `build status` returns before it
    // reaches the constructor, so the ReferenceError appears only on a populated
    // home -- which is every machine that has ever run the builder.
    //
    //     import { DatabaseSync } from "node:sqlite";
    //
    // Task 9 adds the same import for the export/restore routes; whichever lands
    // first owns it, and the other does not repeat it.
    if (sub === "status" && !existsSync(hubPathFor(HOME))) {
      console.log("builder: not running (no hub database yet)");
      break;
    }
    // FIRST RUN has no hub at all, and the reordering below cannot bootstrap one:
    // a raw `DatabaseSync` on a missing `<home>/state` throws outright, and on an
    // existing directory it creates an EMPTY file whose `schema_version` query
    // then fails, because no migration has run. So the command whose job is to
    // create the hub could never reach `openHub`.
    //
    // An absent store has nothing to exclude anyone from and no version to
    // refuse, so it takes the plain path: create it, then claim. The ordering
    // below exists for a store that already carries state.
    // EXISTENCE IS NOT READINESS, and testing the file was the bug.
    //
    // `openHub` creates `schema_version` as plain DDL -- committed the moment it
    // runs -- and only THEN opens the transaction that applies migration 1. A
    // process killed between those two points leaves a hub file that exists,
    // carries `schema_version`, records NO version, and has none of the 31
    // tables. `existsSync` sends that store down the non-bootstrap path, where
    // `acquireSingleton` queries `singleton_lease` and `maintenance_lock` and
    // throws `no such table` -- on every subsequent run, for ever, with no way
    // out but deleting the file by hand. A half-created database is exactly the
    // state a first run is most likely to be interrupted in.
    //
    // The question the branch is really asking is "has any migration COMPLETED",
    // because that is what decides whether there is anything to exclude anyone
    // from. An absent file and an interrupted first migration answer it the same
    // way, and the same reasoning the comment above gives for an absent store
    // applies unchanged to a store at version 0: nothing to refuse, nothing to
    // lock, nobody to lock out.
    // `completedVersion` is imported now rather than defined here. Four other
    // routes needed the same question and each answered it for itself; the two
    // that never asked it are why this is the fifth finding of one shape.
    const bootstrapping = sub === "run" && completedVersion(hubPathFor(HOME)) === 0;
    // `openHub` MIGRATES. So `build run` must not call it until it has taken
    // exclusion, and that ordering is the point rather than an implementation
    // detail: once migration 2 exists, a newer `reeve build run` started beside a
    // live older builder would open, upgrade the database under that running
    // process, and only then be refused by `acquireSingleton`. The refusal
    // arrives correctly and the damage is already done -- the old builder is now
    // operating on a schema it does not understand, which is precisely what the
    // forward-version refusal exists to prevent, defeated by the check that
    // enforces it.
    //
    // So: raw open, refuse a newer store, take the singleton, and only then
    // migrate. The raw handle is the one the lease is taken on; `openHub` runs
    // afterwards on the same path and the migration happens under the lease.
    // `db` is the handle the lease is taken on and the loop keeps. On the
    // bootstrap path that is the migrated handle directly; otherwise it is the
    // raw one, swapped for the migrated handle after the claim.
    // THE OPEN AND THE FIRST READ, TOGETHER, because opening a corrupt
    // database SUCCEEDS and the failure arrives on the first query. Split apart,
    // `build status` died with a raw `file is not a database` and a stack
    // trace, and `build run` died inside `openHub` -- the two commands an
    // operator runs when something is already wrong. `openHub` now refuses an
    // unreadable file with a recovery; this turns that, and the raw path's own
    // version query, into an answer rather than a crash.
    let raw = null;
    let db;
    // EVERY READ `build status` NEEDS, TAKEN INSIDE THE GUARD -- not just the
    // first one.
    //
    // Extending the guard through the schema probe closed the case where
    // corruption sits in the `schema_version` page, and stopped there. A hub
    // whose `schema_version` page is healthy and whose populated
    // `singleton_lease` page is not answers the probe, leaves the try, and then
    // throws `database disk image is malformed` at the lease query -- a raw Node
    // stack trace from the command an operator runs to find out what is wrong.
    // Eighth finding of one class, and every previous one was fixed by moving
    // the guard to the read that had just been discovered.
    //
    // So the guard is no longer positioned against a known read: this collects
    // everything the route reads, and nothing below it touches the database.
    // Rendering cannot throw a SQLite error because rendering does not query.
    // A read added here later is inside the guard by construction; one added
    // below has nothing left to read.
    let status = null;
    try {
      db = bootstrapping
        ? openHub(hubPathFor(HOME))
        : (raw = sub === "status"
            ? new DatabaseSync(hubPathFor(HOME), { readOnly: true })
            // The constant, not the number it happens to equal. #40 exported it
            // so the hub's contention budget had one home; this literal is what
            // that change left behind in the same file.
            : new DatabaseSync(hubPathFor(HOME), { timeout: HUB_BUSY_TIMEOUT_MS }));
      // The first read is what proves the file answers at all. On the raw path
      // nothing has touched it yet, so this is where a corrupt store surfaces.
      // Its VALUE is kept: `build status` re-read the same version a few lines
      // later, outside the guard, which is one more read than the route needs
      // and one the guard did not cover.
      const probed = raw ? raw.prepare("SELECT COALESCE(max(version),0) v FROM schema_version").get().v : null;
      if (sub === "status")
        // ONLY WHAT THIS BINARY IS ENTITLED TO READ.
        //
        // Below version 1 `singleton_lease` may not exist at all, and asking for
        // it there would report an unmigrated hub as unreadable -- a different
        // wrong answer. ABOVE this binary's version the shape is UNKNOWN, and
        // that is the half collecting the reads under the guard introduced: the
        // forward-version refusal happens after this block, so a future
        // migration that reshapes or drops `singleton_lease` would make an older
        // `build status` call a healthy newer hub unreadable and recommend
        // `restore --hub --force` -- replacing a store whose only problem is that
        // this binary is too old to read it. Reproducible with a version-2 marker
        // and no `singleton_lease`.
        //
        // A version this binary does not know is not a shape it may assume. The
        // refusal below is the answer, and it needs no table but `schema_version`.
        status = { version: probed,
                   lease: (probed >= 1 && probed <= HUB_SCHEMA_VERSION)
                     ? (db.prepare("SELECT * FROM singleton_lease WHERE name='builder'").get() ?? null)
                     : null };
    } catch (e) {
      try { raw?.close(); } catch { /* the refusal below is the answer either way */ }
      if (sub === "status") {
        // WHICH failure, here too. This catch is independent of `openHub`'s and
        // had no split at all, so a healthy DELETE-journal hub held by an
        // exclusive transaction answered `database is locked` and was handed the
        // corruption recovery -- an instruction to replace it.
        const kind = faultKind(e);
        const benign = kind !== "damage";
        // UNKNOWN, not "not running". An exclusive transaction stops this before
        // the singleton lease can be read, so the command was ANSWERING a
        // question it had not been able to ask -- and answering it negatively,
        // while a live builder's lease said otherwise. Absence of a reading is
        // not a reading of absence.
        // UNKNOWN EITHER WAY. The verdict is about whether the lease could be
        // READ, and neither branch got that far -- so reporting "not running"
        // on the corrupt one was the same mistake, made twice, and the more
        // dangerous half: it invites the operator to follow the forced-restore
        // advice below WITHOUT stopping a builder that may still be live.
        //
        // What differs between the branches is the RECOVERY, not the verdict.
        console.log(`builder: UNKNOWN (the hub at ${hubPathFor(HOME)} ${benign ? "could not be read just now" : "cannot be read"})`);
        console.log(`  why      ${String(e.message).split("\n")[0]}`);
        // `--tail` NAMED HERE TOO. Every other recovery line in this change says
        // it, and this one did not -- so an operator with a durable export who
        // followed this exact command would restore the snapshot and silently
        // drop every event after it, on the first recovery they attempt.
        if (kind === "full") {
          // A FULL STORE HAS ITS OWN REMEDY. Folded into the benign branch it was
          // told to stop other processes and check permissions -- advice that
          // cannot work -- while the one instruction that can went unsaid.
          // TWO CAUSES answer errcode 13, and the page limit is not the disk.
          // A store that has hit `max_page_count` is unaffected by anything an
          // operator deletes, so an advice block naming only the filesystem sends
          // them to free space that was never the problem.
          console.log(`  recover  the file answered, so this is not damage: the store ran out of room.`);
          console.log(`           Two causes answer this, and only one is the disk:`);
          console.log(`           1. the filesystem is full -- free space on the one holding the hub.`);
          console.log(`              Remove old snapshot files DIRECTLY: reeve backup --hub --keep N`);
          console.log(`              writes a whole new snapshot before it prunes, so it needs more`);
          console.log(`              room, not less.`);
          console.log(`           2. the database hit its page limit -- compare PRAGMA max_page_count`);
          console.log(`              with PRAGMA page_count; if they meet, freeing space changes`);
          console.log(`              nothing and the limit is what has to move.`);
          console.log(`           Do NOT restore over it in either case.`);
        } else if (benign) {
          console.log(`  recover  the file answered, so this is not damage: stop any running builder or`);
          console.log(`           reeve CLI and re-run, and check the permissions on the hub and its`);
          console.log(`           directory. Do NOT restore over it.`);
        } else {
          console.log(`  recover  STOP any running builder first -- this command could not read the`);
          console.log(`           lease, so it cannot tell you whether one is live.`);
          console.log(`           reeve restore --hub --force then installs the newest usable snapshot;`);
          console.log(`           add --tail <file> from a durable export-events --hub to carry`);
          console.log(`           forward every event after that snapshot; without one they are lost`);
        }
        // EXIT 1, not the `break` the other "not running" cases take. Before this
        // guard the uncaught throw exited 1; catching it and breaking would have
        // turned a loud failure into a quiet success, which is the same
        // absence-reads-as-healthy trap the crash at least avoided by accident.
        // An unreadable hub is not "no builder is running", it is a fault.
        process.exit(1);
      }
      die(`reeve build run: ${e.message}`);
    }
    if (sub === "status") {
      // Reading a NEWER store is refused, rather than rendering columns this
      // binary does not understand.
      const v = status.version;
      if (v > HUB_SCHEMA_VERSION)
        die(`the hub is at schema version ${v}; this reeve knows ${HUB_SCHEMA_VERSION}. Upgrade reeve.`);
      // And version 0 is refused too. The comment here used to say "reading an
      // unmigrated store is fine", which was the false premise: `openHub`
      // commits `schema_version` as plain DDL BEFORE migration 1's transaction,
      // so an interrupted first run leaves a store where the query above
      // succeeds and returns 0 while `singleton_lease` -- queried immediately
      // below -- does not exist. `build status` then died with an uncaught
      // SQLite stack trace instead of reporting the builder state, which is the
      // one thing it exists to do.
      //
      // THIRD site of one class. `build run` and `restoreHub` were fixed for the
      // same reason and this was missed, because the sweep matched where I
      // remembered the pattern rather than everywhere the invariant holds.
      // Existence is not readiness, and neither is openability.
      if (v < 1) {
        console.log("builder: not running (the hub's first migration never completed)");
        console.log(`  hub      ${hubPathFor(HOME)}`);
        console.log(`  recover  reeve build run finishes it, or reeve restore --hub --force installs a snapshot`);
        break;
      }
      // Read above, under the guard. Querying it here is what put the eighth
      // readiness finding outside every recovery this route offers.
      const row = status.lease;
      if (!row) { console.log("builder: not running (no singleton lease)"); break; }
      const alive = isSameProcess(row.pid, row.lstart);
      console.log(`builder: ${alive ? "running" : "LEASE HELD BY A DEAD PROCESS"}`);
      console.log(`  pid      ${row.pid} (started ${row.lstart})`);
      console.log(`  command  ${row.command}`);
      console.log(`  lease    expires ${new Date(row.expires_at * 1000).toISOString()}`);
      if (!alive) console.log(`  recover  reeve build run --takeover`);
      break;
    }
    // --takeover is PRINTED as the one recovery command, so it has to work.
    // Without parsing it, an operator who follows the instruction is refused
    // exactly as before and the builder stays down until the lease expires --
    // a recovery path that does not recover. Takeover still requires the holder
    // to be provably dead; it only waives the "and the lease has expired" half,
    // which is the half that has nothing to do with whether anyone is there.
    // ONE startup identity, computed once and reused by the claim, every
    // heartbeat and the release. Recomputing per call is worse than redundant:
    // readStart can transiently return null, and a heartbeat passing a different
    // lstart than the claim silently stops matching its own row. `lstartOf` was
    // referenced here and never defined; this is the definition.
    const lstart = readStart(process.pid);
    if (!lstart) die("cannot read this process's start time; refusing a lease that liveness could never match");

    // The forward-version refusal on the RAW handle, before anything is written.
    // `build status` does this already; `build run` needs it for the same reason
    // and one step earlier, because its next act would be to migrate.
    // Skipped when bootstrapping: `openHub` has already made the store, and it
    // performs this same refusal itself, so re-asking is redundant rather than
    // wrong -- but the query would run against a store this branch just created,
    // which is a check that can only ever pass.
    if (!bootstrapping) {
      const v = db.prepare("SELECT COALESCE(max(version),0) v FROM schema_version").get().v;
      if (v > HUB_SCHEMA_VERSION)
        die(`the hub is at schema version ${v}; this reeve knows ${HUB_SCHEMA_VERSION}. Upgrade reeve.`);
    }
    // TAKING THE LEASE IS A WRITE, and a hub can be perfectly readable and still
    // refuse one -- a read-only file or directory, or another process holding
    // it. Found while verifying this change's own guard: `openHub` and the
    // version read both pass on a read-only hub, and the failure then escaped
    // from `locks.mjs` as a raw `attempt to write a readonly database` with a
    // stack trace. The guard above covers the open and the first READ; this is
    // the first WRITE, and it needs its own answer for the same reason.
    let claim;
    try {
      claim = acquireSingleton(db, {
        name: "builder", pid: process.pid, lstart,
        command: process.argv.slice(1).join(" "), isAlive: isSameProcess,
        takeover: flag("takeover"),
      });
    } catch (e) {
      // AND HERE. `no such table: maintenance_lock` is errcode 1 -- a version-1
      // hub can answer the version probe with its lock tables gone -- and this
      // catch claimed the hub was fine and told the operator NOT to restore it,
      // which is the one thing that would have recovered it.
      // A RESTORE IN PROGRESS IS AN ANSWER, not a failure. `assertWritable`
      // throws it deliberately, and its advice is to WAIT -- not to check
      // permissions, and certainly not to start a second restore.
      if (/restore is in progress/.test(String(e.message)))
        die(`reeve build run: ${e.message}.\n` +
            `  recover  wait for it to finish and re-run; the hub is read-only until it does.\n` +
            `           reeve build status shows whether it is still going.`);
      // THE SAME THREE ANSWERS AS `build status`. A lease write on a full
      // filesystem answered SQLITE_FULL, and this branch told the operator to
      // check permissions and stop other builders -- neither of which frees a
      // byte. The kind decides the sentence; the classification is unchanged.
      const leaseKind = faultKind(e);
      die(leaseKind === "full"
        ? `reeve build run: could not take the builder lease in ${hubPathFor(HOME)} (${e.message}).\n` +
          `  the hub reads fine, so this is not damage: the store ran out of room.\n` +
          `  recover  two causes answer this, and only one is the disk.\n` +
          `           1. the filesystem is full -- free space on the one holding ${hubPathFor(HOME)}.\n` +
          `              Remove old snapshot files DIRECTLY: reeve backup --hub --keep N writes a\n` +
          `              whole new snapshot before it prunes, so it needs more room, not less.\n` +
          `           2. the database hit its page limit -- compare PRAGMA max_page_count with\n` +
          `              PRAGMA page_count; if they meet, freeing space changes nothing.\n` +
          `           Do NOT restore over it in either case.`
        : leaseKind === "operational"
        ? `reeve build run: could not take the builder lease in ${hubPathFor(HOME)} (${e.message}).\n` +
          `  the hub reads fine, so this is not damage: the file or its directory may be read-only, ` +
          `or another process may hold it.\n` +
          `  recover  check the permissions on ${hubPathFor(HOME)} and its directory, and stop any ` +
          `other builder. Do NOT restore over it.`
        : `reeve build run: the hub at ${hubPathFor(HOME)} could not take the builder lease (${e.message}).\n` +
          `  the file opens and reports its version, but the tables the lease needs did not answer.\n` +
          `  recover  reeve restore --hub --force installs the newest usable snapshot; add\n` +
          `           --tail <file> from a durable export-events --hub to carry history forward`);
    }
    if (!claim.ok) {
      const h = claim.holder;
      // A lock refusal that does not say who holds it turns a two-second
      // problem into an investigation.
      die(`another builder holds the lease\n` +
          `  pid      ${h.pid} (started ${h.lstart})\n` +
          `  command  ${h.command}\n` +
          `  held     ${h.ageSeconds}s, expires at ${new Date(h.expiresAt * 1000).toISOString()}\n` +
          `  recover  ${claim.recovery}`);
    }
    // MIGRATE NOW, under the lease, and only now. This is the second half of
    // the reordering above: the raw handle established exclusion without
    // writing, and `openHub` is what applies forward migrations -- so running it
    // here means the upgrade happens with the singleton held and no other
    // builder can be mid-tick against the old schema. The raw handle is closed
    // first: two open handles to the same file is a WAL sidecar waiting to be
    // read back by whichever closes last.
    //
    // The lease row survives the swap. It is a row in the database, not state on
    // the handle, and `acquireSingleton` is re-entrant for the same (pid,
    // lstart) -- which is exactly the property the re-entrancy test exists for.
    // REBIND `db`, do not shadow it. An earlier revision closed `raw` -- which
    // `db` aliased -- and bound the migrated handle to a NEW name, so every
    // later `releaseSingleton(db, ...)` and `heartbeatSingleton(db, ...)` ran
    // against a closed database: the first heartbeat threw, the loop died, and
    // the lease row was left behind by a process that never ran a tick. The
    // whole reordering made `build run` worse than it was.
    //
    // Nothing to do on the bootstrap path: `db` is already the migrated handle.
    if (raw) { raw.close(); db = openHub(hubPathFor(HOME)); }
    // Hold the lease for the life of the process, and give it back on the way
    // out. Claiming and then returning would exit immediately: the service
    // manager (KeepAlive) relaunches, the new process finds a lease held by a
    // pid that just died, and the job flaps -- while `reeve build status`
    // reports a holder that is never there. A lease nobody heartbeats is also
    // indistinguishable from a crashed holder after LEASE_SECONDS.
    //
    // S2's loop does exactly two things; the phase tick lands in PR-B.
    let running = true;
    const stop = (sig) => {
      if (!running) return;
      running = false;
      releaseSingleton(db, { name: "builder", pid: process.pid, lstart });
      // `console.log`, not `log`. `bin/reeve` neither defines nor imports a
      // `log` binding -- that is `src/daemon.mjs`'s file-scoped helper -- so the
      // lease was released and the shutdown then threw ReferenceError instead of
      // exiting cleanly, and the lost-heartbeat branch below crashed before
      // printing the diagnostic that is its entire purpose. Both use the console.
      console.log(`build run: released the singleton lease on ${sig}`);
      process.exit(0);
    };
    for (const sig of ["SIGINT", "SIGTERM"]) process.on(sig, () => stop(sig));

    // What the last tick could not refresh, so a CHANGE is reported and a steady
    // state is not repeated every heartbeat.
    let lastSkipped = null;
    while (running) {
      // A heartbeat that fails means the row is no longer ours -- a takeover, or
      // a restore that replaced the file. Authority is gone, so the loop stops
      // rather than ticking on without it (section 1.2).
      if (!heartbeatSingleton(db, { name: "builder", pid: process.pid, lstart })) {
        // `console.error`, like the shutdown path. `bin/reeve` has no `log`
        // binding, so this threw before printing the diagnostic that is the entire
        // reason the branch exists -- a lost lease reported as a ReferenceError
        // about logging.
        console.error("build run: lost the singleton lease; another process holds it. Stopping.");
        process.exit(1);
      }
      // THE TICK. It lives in `build/loop.mjs` rather than here so the wiring can
      // be tested without spawning a daemon -- this is a heartbeat loop, and
      // invoking it from a test starts one.
      //
      // No fetcher is wired in S2, and that is deliberate rather than unfinished:
      // `buildTick` defaults to one returning null, which writes an `unknown`
      // gate-state row carrying why. "reeve has not looked" is the honest reading,
      // and it is what clause U4 must see rather than a default that resembles a
      // pass. S8 supplies the real rulesets client.
      //
      // A tick that throws must not kill the daemon: the lease is still held and
      // the next pass may well succeed, so the failure is reported and the loop
      // continues. `refreshGateState` already turns a fetcher's throw into a row.
      try {
        // A BROKEN REGISTRY IS NOT AN EMPTY ONE. `registryProjects` returns
        // `{ projects: [], error }` for a file that is unreadable, invalid JSON,
        // or carries a malformed entry -- and reading only `.projects` turned all
        // three into a clean pass over nothing. The daemon then reported neither
        // a failure nor a skipped project while every existing gate-state row
        // aged into staleness, which clause U4 reads as UNKNOWN: fail-closed, but
        // silently, from the one component that could have said why.
        const registry = registryProjects(HOME);
        if (registry.error) throw new Error(registry.error);
        const tick = await buildTick({ hub: db, projects: registry.projects ?? [] });
        // AND THE TICK'S OWN REPORT IS READ. `buildTick` returns what it could
        // not refresh precisely because a pass that refreshed nothing is
        // indistinguishable from one that refreshed everything -- and this
        // caller threw the answer away, so a tick that skipped every project on
        // every heartbeat looked exactly like a healthy one from outside.
        const note = tick.skipped.length ? tick.skipped.join(", ") : "";
        if (note !== lastSkipped) {
          if (note) console.error(
            `build run: no gate state for ${note} -- no repository id yet; ` +
            `it is resolved from the hub once a task has been filed for the project`);
          else if (lastSkipped !== null)
            console.log("build run: every registry project now has a repository id");
          lastSkipped = note;
        }
      } catch (e) {
        console.error(`build run: tick failed (${e.message}); the lease is still held, continuing`);
      }
      // `sleep` is not a global -- spelled out here.
      await new Promise(r => setTimeout(r, HEARTBEAT_SECONDS * 1000));
    }
    break;
  }

  case "run":
  case "tick": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve run: no repo. Pass owner/repo or run inside a git checkout."); process.exit(1); }
    const profile = loadProfile(nwo);
    if (!profile) { console.error(`reeve run: no profile for ${nwo}.\n-> reeve init`); process.exit(1); }
    // Keyed by owner AND repo. An existing store at the old short-name path is
    // moved rather than abandoned: opening a fresh empty database instead is how
    // real history stops being read without anything appearing to fail.
    // Absolute before it is opened OR protected: `stateRootsFor` drops every
    // non-absolute candidate, so a relative --db opened fine and was denied to
    // nobody. (Codex #4g-[2].)
    const dbPath = resolve(opt("db") ?? stateFor(nwo));
    if (!existsSync(dbPath)) { console.error(`reeve run: no state database at ${dbPath}`); process.exit(1); }
    // Resolved before the context so the REASON survives. A project that is
    // simply not registered is `{ project: null, why: null }` -- an ordinary
    // state. A registry that could not be parsed is a fault that says so.
    const registry = registryProjects(HOME);
    const guardianProject = {
      project: (registry.projects ?? []).find(p => p.nwo === nwo) ?? null,
      why: (registry.projects ?? []).some(p => p.nwo === nwo) ? null : (registry.error ?? null),
    };
    const ctx = {
      nwo, profile, db: open(dbPath),
      // The database's own path: the worker must not be able to read the event
      // store, whatever --db points at.
      dbPath,
      logPath: resolve(opt("log") ?? join(HOME, "reeve.log")),
      haltMarker: opt("halt") ?? join(HOME, "HALT"),
      // Execution is opt-in. A loop that acts before its decisions have been
      // watched is how an unattended run becomes an incident.
      execute: flag("execute"),
      // Shadow until the week's evidence says otherwise. --enforce is the flip.
      shadow: !flag("enforce"),
      intervalMs: Number(opt("interval") ?? 90) * 1000,
      dashPath: opt("dash") ?? dashPathFor(HOME, nwo),
      // The sandbox canary's result is written here and read by `reeve doctor`
      // from the same place, independent of any --log directory.
      canaryStateDir: HOME,
      // THE GUARDIAN'S OWN START TIME, read once. `provider_lease` is reaped by
      // `isAlive(pid, lstart)`, and a lease whose holder has no start time can
      // never be recognised as dead: a pid alone is reused.
      lstart: readStart(process.pid),
      // THE RESTRICTED CONNECTION, never `openHub`. The guardian's hub surface is
      // the provider scheduler and `pr_hold`, and a comment saying so is checked
      // by whoever remembers -- this is checked by the connection. `openHub`
      // would hand the guardian the whole schema and every migration right.
      //
      // Absent rather than open when there is no hub: a guardian on a machine
      // with no builder has nothing to schedule against, and `tick` treats a
      // missing `ctx.hub` as "unscheduled" rather than failing.
      // A GETTER, called per tick. See `guardianHubAccess`: the hub file is
      // replaced wholesale by a restore, and a cached handle would go on
      // scheduling in an unlinked database while the builder used the new one.
      hub: guardianHubAccess(),
      // The registry entry for THIS repository, which is what the repository-id
      // resolver is keyed on. A rename changes `nwo` and never the id, so the
      // project key is the stable half; a repository absent from the registry
      // has no project and the guardian dispatches unscheduled.
      project: guardianProject.project,
      // WHY there is no project, when there is a reason. `registryProjects`
      // rejects the WHOLE registry if any single entry is malformed -- by
      // design, because a partially-read registry silently narrows what doctor
      // reports on. But converting that global diagnostic into a bare
      // `project: null` here meant one unrelated bad entry left this repository
      // unable to resolve its numeric id: every provider dispatch fail-closed
      // and every builder-PR hold UNKNOWN, with nothing saying why.
      projectError: guardianProject.why,
    };
    // RESOLVED HERE, not in the tick, because the tick's connection cannot read
    // it. Re-resolved on the tick's own cadence through this same closure when
    // it comes back null -- a project whose first task is admitted after the
    // daemon started would otherwise leave the guardian fail-closed on every
    // dispatch until someone restarted it.
    // AND THE REGISTRY IS RE-READ WHEN THERE IS STILL NO PROJECT.
    //
    // `ctx.project` was fixed at startup, so a `projects.json` that was missing,
    // malformed, or simply did not name this repository yet pinned it to null for
    // the life of the process -- and this closure then called `repoIdOnce(null)`
    // every ten minutes for ever. Adding the entry could not recover the daemon:
    // every provider dispatch stayed fail-closed and every builder-PR hold stayed
    // UNKNOWN until someone restarted it, while the retry cadence advertised that
    // it was trying. A retry that cannot observe the thing it is waiting for is
    // not a retry.
    //
    // Only when there is no project: a registry read per tick is wasted work once
    // the answer is known, and the project key is stable by design.
    ctx.resolveRepoId = () => {
      if (!ctx.project) {
        const again = registryProjects(HOME);
        const found = (again.projects ?? []).find(p => p.nwo === nwo) ?? null;
        ctx.project = found;
        // The WHY is refreshed with it, or a registry that has been fixed would
        // go on reporting the stale reason it was broken for.
        ctx.projectError = found ? null : (again.error ?? null);
      }
      return repoIdOnce(ctx.project);
    };
    // GUARDED, because this one is OUTSIDE the tick. Narrowing `repoIdOnce`'s
    // catch so operational failures propagate was right for the retry path
    // inside `tick`, which logs them and raises `guardian:hub:unreadable` -- and
    // it made THIS call, which has no such catch, able to kill `reeve run` at
    // startup over a transient lock. A fix that makes an error visible must not
    // make it fatal somewhere the error was previously impossible.
    //
    // Left null on failure: the tick re-asks on its own cadence through the same
    // resolver, and until it succeeds the guardian fails closed and says so.
    try {
      ctx.repoId = await repoIdOnce(ctx.project);
    } catch (err) {
      console.error(`reeve run: the repository id could not be resolved at startup (${err.message}); ` +
                    `continuing, and the tick will retry.`);
      ctx.repoId = null;
    }
    // Honour the FLAG as well as the command. The help has always documented
    // `run --tick` as "one pass and exit" while only the separate `tick` command
    // did that, so `reeve run --tick` started the long-running daemon -- the
    // opposite of what it promised.
    if (cmd === "tick" || flag("tick")) { const r = await tick(ctx); process.exit(r.halted ? 3 : 0); }
    await run(ctx);
    process.exit(0);
  }

  default:
    usage();
    process.exit(cmd ? 1 : 0);
}

/**
 * The only help this CLI has, printed by `--help` and by an unrecognised
 * command alike.
 *
 * A `function` declaration on purpose: `--help` is dispatched above the switch,
 * before any route can run, and only a declaration is hoisted that far. It also
 * has to be ONE text -- `--help` that describes a different CLI from the one the
 * bare command describes is two helps, and one of them is wrong.
 *
 * Every command in the switch is named here, and `test/cli-flags.test.mjs`
 * asserts that both ways. `export-events`, `shadow`, `builder` and `build` were
 * all shipped and none of them appeared here, so the only help reeve had
 * described a CLI that no longer existed.
 */
function usage() {
  console.log(`reeve ${JSON.parse(execFileSync("cat", [join(ROOT, "package.json")], { encoding: "utf8" })).version}

  doctor [owner/repo]   what is actually true right now   (0 ok · 1 broken · 3 degraded)
      --db <path>           state database to inspect
      --plugin-cache <dir>  plugin cache root, to detect running-vs-reviewed drift
      --plugin-repo <dir>   the reviewed copy to compare it against
      --json                machine-readable

  init                  detect this repo, preview a profile, then --write it
      --set k=v             answer a question detection could not settle (repeatable)
      --write               apply  (exit 0 no-op · 2 changed · 1 needs an answer)

  canary [owner/repo]   measure the worker sandbox for real, without arming anything
                        (a throwaway worker, minutes, a real model call; 0 closed · 1 open)

  status [owner/repo]   what is happening now  (--health measures clean-merge, --json)
  why <pr>              why reeve decided what it decided, newest first
  statusline            one line for the terminal statusline; reads state only
  dash                  write the one-page view  (--health, --out <path>, --open)
  shadow [owner/repo]   compare what reeve would have decided against what happened

  backup [owner/repo]   a restorable snapshot of the store  (--events for JSONL, --to <dir>)
      --hub                 snapshot the builder hub instead of a repository store
      --keep <n>            how many snapshots to retain
  restore [owner/repo]  put one back  (--from <file>, --overwrite, --force)
      --hub                 restore the builder hub  (--tail <file> replays events after it)
  export-events --hub <file>
                        write the hub's event log as a replayable JSONL tail

  task file             file a task, with its territory declared and leased
      --project <p>         the registry project to file against
      --title "..."         what the task is called
      --territory <path>    a path the task claims; repeatable
      --territory-file <f>  a file of claims, one per line; composes with --territory
      --depth <d>           trivial, standard or deep
      --priority <p>        p1 or p2  (default p2)
      --pin-territory <d>   hold the territory for a duration like 48h or 3d
      --idempotency-key <k> makes a re-run of this command inert
      --anyway              file a near-twin of an existing task anyway
      --dry-run             print what would happen and write nothing

  builder doctor        what is true about the builder hub  (--json)
  build run             the builder loop; one at a time, by lease  (--takeover)
  build status          who holds the builder lease, and since when

  run [owner/repo]      the daemon: watch, publish, decide, on a loop
      --tick                one pass and exit
      --execute             dispatch workers (default: report only)
      --enforce             publish real conclusions (default: shadow/neutral)
      --interval <seconds>  default 90
      --halt <path>         marker file that stops everything (default ~/.reeve/HALT)

  everywhere:
      --home <dir>          the reeve home to operate on (default $REEVE_HOME, else ~/.reeve)
      --help                print this and do nothing else

not yet built: next · plan · lane`);
}
