#!/usr/bin/env node
// reeve — the control plane's front door.
//
// Node >=24 is a hard floor: node:sqlite still emits an ExperimentalWarning on
// 22.x and the state layer is the authority, so it must not run under a warning
// it might one day become.
import { runDoctor, render, checkAppIdentity } from "../src/doctor.mjs";
import { open } from "../src/db/ops.mjs";
import { statePathFor, dashPathFor, legacyStatePathFor, legacyDashPathFor } from "../src/paths.mjs";
import { snapshot, restore, latestSnapshot, exportEvents } from "../src/backup.mjs";
import { validate, withDefaults } from "../src/profile/schema.mjs";
import { run, tick } from "../src/daemon.mjs";
import { readState, render as renderStatus, statusline, why, cleanMergeRate } from "../src/status.mjs";
import { init } from "../src/init.mjs";
import { writeDash } from "../src/dash.mjs";
import { execFileSync } from "node:child_process";
import { existsSync, mkdirSync, renameSync, readFileSync } from "node:fs";
import { join, dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { homedir } from "node:os";

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));

// One home for every command. Four of them read REEVE_HOME and loadProfile did
// not, so a scratch home redirected a project's state database but not the
// profile describing it -- the two halves of one project's configuration read
// from different roots, which is unusable for a test and wrong for an operator.
const HOME = process.env.REEVE_HOME ?? join(homedir(), ".reeve");

const [major] = process.versions.node.split(".").map(Number);
if (major < 24) {
  console.error(`reeve: node ${process.versions.node} — node:sqlite is only unflagged and unwarned from 24. Use 24 or newer.`);
  process.exit(1);
}

const argv = process.argv.slice(2);
const cmd = argv.shift();
const flag = n => argv.includes(`--${n}`);
const opt = n => { const i = argv.indexOf(`--${n}`); return i < 0 ? null : argv[i + 1]; };
const VALUED = new Set(["db", "plugin-cache", "plugin-repo", "profile", "set", "log", "halt", "interval", "last", "out", "dash"]);
// Positionals only. A valued flag consumes the token after it, so that token is
// never mistaken for a repo name however much it looks like one.
const positionals = (() => {
  const out = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) { if (VALUED.has(a.slice(2))) i++; continue; }
    out.push(a);
  }
  return out;
})();

/** Repo identity is the remote, never the path: one repo can sit at two paths on two commits. */
/**
 * Move a store from its old short-name path to the owner-scoped one, once.
 *
 * Returns the new path either way. Copying rather than moving would leave two
 * databases that both look live, and the daemon would keep writing to whichever
 * one it opened first.
 */
function adoptLegacy(next, legacy) {
  try {
    if (!existsSync(next) && existsSync(legacy)) {
      mkdirSync(dirname(next), { recursive: true });
      for (const suffix of ["", "-wal", "-shm"]) {
        if (existsSync(legacy + suffix)) renameSync(legacy + suffix, next + suffix);
      }
      console.error(`reeve: moved ${legacy} -> ${next}`);
    }
  } catch (e) { console.error(`reeve: could not move the legacy store (${e.message}); using ${legacy}`); return legacy; }
  return next;
}

/**
 * Where one project's state lives. The single answer for every command.
 *
 * Five commands resolved this independently and one of them drifted: `doctor`
 * read `profile.state.location`, which the profile schema defines as the SIBLING
 * REPOSITORY holding a project's ledger -- "nextlyhq/nextly-ledger" -- not a path
 * on this disk. existsSync said no, doctor took that for "there is no state
 * database", and its lease check silently answered UNKNOWN for a store sitting
 * right there. A repeated resolution is a resolution that will drift again, so
 * there is now only one.
 */
const stateFor = nwo => adoptLegacy(statePathFor(HOME, nwo), legacyStatePathFor(HOME, nwo));

function detectNwo() {
  try {
    const url = execFileSync("git", ["remote", "get-url", "origin"], { encoding: "utf8" }).trim();
    const m = url.match(/[:/]([^/:]+\/[^/]+?)(?:\.git)?$/);
    return m ? m[1] : null;
  } catch { return null; }
}

function loadProfile(nwo) {
  const sidecar = join(HOME, "profiles", `${nwo}.json`);
  const inRepo = join(process.cwd(), ".ops", "profile.json");
  for (const p of [inRepo, sidecar]) {
    if (!existsSync(p)) continue;
    let raw;
    try { raw = JSON.parse(readFileSync(p, "utf8")); }
    catch (e) { console.error(`reeve: ${p} is not valid JSON — ${e.message}`); process.exit(1); }
    const profile = withDefaults(raw);
    const r = validate(profile);
    if (!r.ok) {
      // A profile that does not validate is refused, never partially applied: a
      // half-loaded profile is how a gate ends up judging the wrong check name.
      console.error(`reeve: ${p} is invalid`);
      for (const e of r.errors) console.error("  error:", e);
      process.exit(1);
    }
    for (const w of r.warnings) console.error("  warn:", w);
    return { path: p, ...profile };
  }
  return null;
}

switch (cmd) {
  case "doctor": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve doctor: no repo. Pass owner/repo or run inside a git checkout."); process.exit(1); }
    const profile = loadProfile(nwo) ?? {};
    // Absent is a real answer here -- a project reeve has never run against has no
    // store yet -- so doctor reports on what it finds rather than refusing to run.
    const dbPath = opt("db") ?? stateFor(nwo);
    const db = dbPath && existsSync(dbPath) ? open(dbPath) : null;
    // Documented in docs/github-app-setup.md as the step that proves the App works.
    const appCheck = flag("as-app") ? await checkAppIdentity(nwo) : null;
    const result = runDoctor({
      nwo, profile, db, appCheck,
      pluginCacheRoot: opt("plugin-cache"),
      repoPluginDir: opt("plugin-repo"),
      // Where the daemon records its canary: the same HOME the daemon logs to.
      stateDir: HOME,
    });
    if (flag("json")) console.log(JSON.stringify(result, null, 2));
    else console.log(render(result, nwo));
    if (!profile.path && !flag("json")) {
      console.log(`\nno profile for ${nwo}. Checks that need one were skipped.\n-> reeve init`);
    }
    process.exit(result.exitCode);
  }
  case "backup": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve backup: no repo."); process.exit(1); }
    const dbPath = opt("db") ?? stateFor(nwo);
    if (!existsSync(dbPath)) { console.error(`reeve backup: no state at ${dbPath}`); process.exit(1); }
    const root = opt("to") ?? join(HOME, "backups");
    const db = open(dbPath);
    if (flag("events")) {
      const p = opt("out") ?? join(root, `${nwo.replace("/", "-")}-events.jsonl`);
      mkdirSync(dirname(p), { recursive: true });
      const r = exportEvents(db, p);
      console.log(r.ok ? `${r.count} event(s) -> ${r.path}` : `failed: ${r.why}`);
      process.exit(r.ok ? 0 : 1);
    }
    const r = snapshot(db, root, nwo);
    console.log(r.ok ? `snapshot -> ${r.path}` : `failed: ${r.why}`);
    process.exit(r.ok ? 0 : 1);
  }

  case "restore": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve restore: no repo."); process.exit(1); }
    const from = opt("from") ?? latestSnapshot(opt("to") ?? join(HOME, "backups"), nwo);
    if (!from) { console.error(`reeve restore: no snapshot for ${nwo}`); process.exit(1); }
    const dbPath = opt("db") ?? stateFor(nwo);
    const r = restore(from, dbPath, { overwrite: flag("overwrite"), force: flag("force") });
    console.log(r.ok ? `restored ${from} -> ${dbPath}` : `refused: ${r.why}`);
    process.exit(r.ok ? 0 : 1);
  }

  case "init": {
    // --set key=value, repeatable. Answers only the questions detection could not
    // settle; everything else comes from the repo and is not negotiable.
    const answers = {};
    for (let i = 0; i < argv.length; i++) {
      if (argv[i] !== "--set") continue;
      const kv = argv[++i] ?? "";
      const eq = kv.indexOf("=");
      if (eq < 0) { console.error(`reeve init: --set expects key=value, got ${JSON.stringify(kv)}`); process.exit(1); }
      answers[kv.slice(0, eq)] = kv.slice(eq + 1);
    }
    const r = init({ root: process.cwd(), answers, write: flag("write") });
    console.log(r.output);
    process.exit(r.code);
  }

  case "shadow": {
    // The gate before PR-5. It answers one question -- has the derived review
    // view agreed with the live read, on real pull requests, for long enough --
    // and shows every divergence rather than a pass/fail, because each one has to
    // be explained in writing before the switch is thrown.
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve shadow: no repo."); process.exit(1); }
    const dbPath = opt("db") ?? stateFor(nwo);
    if (!existsSync(dbPath)) { console.error(`reeve shadow: no state at ${dbPath}`); process.exit(1); }
    const db = open(dbPath);
    const { streak, divergences } = await import("../src/review/shadow.mjs");
    const need = Number(opt("days") ?? 5);
    const sk = streak(db, nwo);
    const bad = divergences(db, nwo);

    console.log(`review shadow  ${nwo}`);
    console.log(`  ${sk.days} consecutive day(s) agreeing, over ${sk.comparisons} comparison(s)`);
    console.log(`  target: ${need} days with zero divergence`);
    if (bad.length) {
      console.log(`\n  divergences to explain (${bad.length}):`);
      for (const d of bad) {
        console.log(`    ${d.day}  #${d.pr}  ${d.agreements}/${d.comparisons} agreed`);
        if (d.last_divergence) console.log(`        ${d.last_divergence}`);
      }
    }
    const rows = db.prepare(
      `SELECT day, SUM(comparisons) c, SUM(agreements) a, SUM(incomparable) i
         FROM review_shadow WHERE nwo=? GROUP BY day ORDER BY day DESC LIMIT 10`).all(nwo);
    if (rows.length) {
      console.log("\n  by day:");
      for (const r of rows) {
        console.log(`    ${r.day}  ${r.a}/${r.c} agreed` +
                    (r.i ? `, ${r.i} not comparable` : "") +
                    (r.c && r.a === r.c ? "  ok" : r.c ? "  DIVERGED" : "  nothing compared"));
      }
    } else {
      console.log("\n  nothing compared yet.");
    }
    // The streak already EXCLUDES any day that diverged, so N consecutive clean
    // days ending today is the whole condition. Also requiring that no divergence
    // has ever been recorded would let one bad day -- today's, caused by a bug
    // since fixed -- block the gate permanently, which is a gate that can only
    // ever say no.
    //
    // Old divergences stay listed above. They are history to read, not a veto.
    process.exit(sk.days >= need ? 0 : 3);
  }

  // These four share one body below. A new subcommand must get its OWN block
  // above -- inserted between these labels and the body, its unconditional exit
  // captures all of them, which is how `shadow` silently broke `status` for a day.
  case "status":
  case "statusline":
  case "dash":
  case "why": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    const short = nwo ? nwo.split("/")[1] : null;   // display only, never a path
    // Same resolution as the daemon, or the two would read different databases:
    // one would adopt the legacy store and the other would keep opening it in
    // place, and they would drift without either ever failing.
    const dbPath = opt("db") ?? (nwo ? stateFor(nwo) : null);
    if (!dbPath || !existsSync(dbPath)) {
      // A statusline must never be noisy or slow, so it degrades to one quiet word.
      if (cmd === "statusline") { console.log("reeve: no state"); process.exit(0); }
      console.error(`reeve ${cmd}: no state database${dbPath ? ` at ${dbPath}` : ""}`); process.exit(1);
    }
    const db = open(dbPath);

    if (cmd === "statusline") { console.log(statusline(db, { nwo })); process.exit(0); }
    if (cmd === "dash") {
      const out = opt("out") ?? dashPathFor(HOME, nwo);
      const health = flag("health") && nwo ? { clean: cleanMergeRate(nwo, Number(opt("last") ?? 20)) } : {};
      writeDash(out, { nwo, state: readState(db), health });
      console.log(out);
      if (flag("open")) { try { execFileSync("open", [out]); } catch { /* not macOS */ } }
      process.exit(0);
    }
    if (cmd === "why") {
      const target = positionals.find(a => /^#?\d+$/.test(a) || a.startsWith("pr:"));
      if (!target) { console.error("reeve why <pr-number>"); process.exit(1); }
      console.log(why(db, target));
      process.exit(0);
    }

    const state = readState(db);
    // The health band costs network calls, so it is opt-in on a screen that must
    // stay instant by default.
    const health = flag("health") && nwo
      ? { clean: cleanMergeRate(nwo, Number(opt("last") ?? 20)) }
      : { clean: { ok: false, why: "pass --health to measure (costs API calls)" } };
    if (flag("json")) console.log(JSON.stringify({ state, health }, null, 2));
    else console.log(renderStatus({ nwo, state, health }));
    process.exit(0);
  }

  case "run":
  case "tick": {
    const nwo = positionals.find(a => /^[\w.-]+\/[\w.-]+$/.test(a)) || detectNwo();
    if (!nwo) { console.error("reeve run: no repo. Pass owner/repo or run inside a git checkout."); process.exit(1); }
    const profile = loadProfile(nwo);
    if (!profile) { console.error(`reeve run: no profile for ${nwo}.\n-> reeve init`); process.exit(1); }
    // Keyed by owner AND repo. An existing store at the old short-name path is
    // moved rather than abandoned: opening a fresh empty database instead is how
    // real history stops being read without anything appearing to fail.
    const dbPath = opt("db") ?? stateFor(nwo);
    if (!existsSync(dbPath)) { console.error(`reeve run: no state database at ${dbPath}`); process.exit(1); }
    const ctx = {
      nwo, profile, db: open(dbPath),
      // The database's own path: the worker must not be able to read the event
      // store, whatever --db points at.
      dbPath,
      logPath: resolve(opt("log") ?? join(HOME, "reeve.log")),
      haltMarker: opt("halt") ?? join(HOME, "HALT"),
      // Execution is opt-in. A loop that acts before its decisions have been
      // watched is how an unattended run becomes an incident.
      execute: flag("execute"),
      // Shadow until the week's evidence says otherwise. --enforce is the flip.
      shadow: !flag("enforce"),
      intervalMs: Number(opt("interval") ?? 90) * 1000,
      dashPath: opt("dash") ?? dashPathFor(HOME, nwo),
      // The sandbox canary's result is written here and read by `reeve doctor`
      // from the same place, independent of any --log directory.
      canaryStateDir: HOME,
    };
    // Honour the FLAG as well as the command. The help has always documented
    // `run --tick` as "one pass and exit" while only the separate `tick` command
    // did that, so `reeve run --tick` started the long-running daemon -- the
    // opposite of what it promised.
    if (cmd === "tick" || flag("tick")) { const r = await tick(ctx); process.exit(r.halted ? 3 : 0); }
    await run(ctx);
    process.exit(0);
  }

  default:
    console.log(`reeve ${JSON.parse(execFileSync("cat", [join(ROOT, "package.json")], { encoding: "utf8" })).version}

  doctor [owner/repo]   what is actually true right now   (0 ok · 1 broken · 3 degraded)
      --db <path>           state database to inspect
      --plugin-cache <dir>  plugin cache root, to detect running-vs-reviewed drift
      --plugin-repo <dir>   the reviewed copy to compare it against
      --json                machine-readable

  init                  detect this repo, preview a profile, then --write it
      --set k=v             answer a question detection could not settle
      --write               apply  (exit 0 no-op · 2 changed · 1 needs an answer)

  status [owner/repo]   what is happening now  (--health measures clean-merge, --json)
  why <pr>              why reeve decided what it decided, newest first
  statusline            one line for the terminal statusline; reads state only
  dash                  write the one-page view  (--health, --out <path>, --open)

  backup [owner/repo]   a restorable snapshot of the store  (--events for JSONL, --to <dir>)
  restore [owner/repo]  put one back  (--from <file>, --overwrite, --force)

  run [owner/repo]      the daemon: watch, publish, decide, on a loop
      --tick                one pass and exit
      --execute             dispatch workers (default: report only)
      --enforce             publish real conclusions (default: shadow/neutral)
      --interval <seconds>  default 90
      --halt <path>         marker file that stops everything (default ~/.reeve/HALT)

not yet built: next · plan · lane`);
    process.exit(cmd ? 1 : 0);
}
