{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tools/**/*",
    "test/**/*"
  ]
}
